{% liquid
  assign hero_image = section.settings.image
  assign mobile_image = section.settings.mobile_image | default: hero_image
%}

{% style %}
  #shopify-section-{{ section.id }} .armory-hero {
    --ah-bg: {{ section.settings.background }};
    --ah-overlay: {{ section.settings.overlay_color }};
    --ah-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --ah-heading: {{ section.settings.heading_color }};
    --ah-accent: {{ section.settings.accent_color }};
    --ah-body: {{ section.settings.body_color }};
    --ah-button-bg: {{ section.settings.button_background }};
    --ah-button-text: {{ section.settings.button_text_color }};
    --ah-badge-bg: {{ section.settings.badge_background }};
    --ah-badge-border: {{ section.settings.badge_border }};
    --ah-min: {{ section.settings.desktop_min_height }}px;
    --ah-mobile-min: {{ section.settings.mobile_min_height }}px;
    --ah-content: {{ section.settings.content_width }}px;
    --ah-heading-desktop: {{ section.settings.heading_size_desktop }}px;
    --ah-heading-tablet: {{ section.settings.heading_size_tablet }}px;
    --ah-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --ah-line: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    --ah-body-size: {{ section.settings.body_size }}px;
    --ah-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --ah-focal: {{ section.settings.image_position }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .armory-hero {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{% endstyle %}

<section class="armory-hero armory-hero--x-{{ section.settings.content_horizontal }} armory-hero--y-{{ section.settings.content_vertical }}">
  <div class="armory-hero__media" aria-hidden="true">
    {% if hero_image != blank %}
      <picture>
        {% if mobile_image != blank %}
          <source media="(max-width: 767px)" srcset="{{ mobile_image | image_url: width: 900 }}">
        {% endif %}
        {{ hero_image | image_url: width: 2200 | image_tag: widths: '720, 1000, 1400, 1800, 2200', sizes: '100vw', loading: 'eager', class: 'armory-hero__image' }}
      </picture>
    {% else %}
      <div class="armory-hero__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
    {% endif %}
  </div>
  <div class="armory-hero__shade"></div>

  <div class="armory-hero__inner">
    <div class="armory-hero__content armory-hero__content--{{ section.settings.text_alignment }} armory-hero__content--mobile-{{ section.settings.mobile_text_alignment }}">
      {% if section.settings.eyebrow != blank %}
        <p class="armory-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.badge_text != blank %}
        <p class="armory-hero__status">{{ section.settings.badge_text }}</p>
      {% endif %}
      {% if section.settings.heading != blank or section.settings.accent_heading != blank %}
        <h1>
          {% if section.settings.heading != blank %}
            <span>{{ section.settings.heading }}</span>
          {% endif %}
          {% if section.settings.accent_heading != blank %}
            <em>{{ section.settings.accent_heading }}</em>
          {% endif %}
        </h1>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="armory-hero__body">{{ section.settings.body }}</div>
      {% endif %}
      {% if section.settings.primary_label != blank or section.settings.secondary_label != blank %}
        <div class="armory-hero__actions">
          {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}
            <a class="armory-hero__button armory-hero__button--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
          {% endif %}
          {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
            <a class="armory-hero__button armory-hero__button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>

  {% if section.settings.show_index_badge %}
    <div class="armory-hero__index armory-hero__index--{{ section.settings.index_position }}">
      <strong>{{ section.settings.index_number }}</strong>
      <span>{{ section.settings.index_label }}</span>
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .armory-hero {
    position: relative;
    min-height: var(--ah-min);
    display: grid;
    overflow: hidden;
    color: var(--ah-body);
    background: var(--ah-bg);
    font-family: var(--font-body-family, Inter, ui-sans-serif, system-ui, sans-serif);
  }

  .armory-hero--y-top {
    align-items: start;
  }

  .armory-hero--y-center {
    align-items: center;
  }

  .armory-hero--y-bottom {
    align-items: end;
  }

  .armory-hero__media,
  .armory-hero__shade,
  .armory-hero__media picture,
  .armory-hero__image,
  .armory-hero__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .armory-hero__image,
  .armory-hero__placeholder {
    object-fit: cover;
    object-position: var(--ah-focal);
  }

  .armory-hero__placeholder {
    display: grid;
    place-items: center;
    background: radial-gradient(circle at 70% 34%, rgba(214,146,171,.16), transparent 28%), linear-gradient(115deg, #210817, #0e090d 75%);
  }

  .armory-hero__placeholder svg {
    width: min(420px, 44%);
    opacity: .18;
  }

  .armory-hero__shade {
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(33,8,23,.95), rgba(33,8,23,.7) 35%, rgba(33,8,23,.18) 70%),
      var(--ah-overlay);
    opacity: var(--ah-overlay-opacity);
  }

  .armory-hero__inner {
    position: relative;
    z-index: 2;
    width: min(var(--page-width, 1360px), calc(100vw - 96px));
    margin-inline: auto;
    display: grid;
  }

  .armory-hero--x-center .armory-hero__inner {
    justify-items: center;
  }

  .armory-hero--x-right .armory-hero__inner {
    justify-items: end;
  }

  .armory-hero__content {
    width: min(100%, var(--ah-content));
  }

  .armory-hero__content--center {
    text-align: center;
  }

  .armory-hero__content--right {
    text-align: right;
  }

  .armory-hero__eyebrow {
    margin: 0 0 12px;
    color: var(--ah-body);
    font-size: var(--ah-eyebrow-size);
    font-weight: 850;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .armory-hero__status {
    width: fit-content;
    margin: 0 0 18px;
    padding: 7px 12px;
    color: var(--ah-accent);
    border: 1px solid rgba(214,146,171,.52);
    font-size: 10px;
    font-weight: 850;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .armory-hero__content--center .armory-hero__status {
    margin-inline: auto;
  }

  .armory-hero h1 {
    margin: 0;
    color: var(--ah-heading);
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(var(--ah-heading-mobile), 7vw, var(--ah-heading-desktop));
    font-weight: 500;
    line-height: var(--ah-line);
  }

  .armory-hero h1 span,
  .armory-hero h1 em {
    display: block;
  }

  .armory-hero h1 em {
    color: var(--ah-accent);
    font-style: italic;
  }

  .armory-hero__body {
    max-width: 560px;
    margin-top: 24px;
    color: var(--ah-body);
    font-size: var(--ah-body-size);
    line-height: 1.75;
    opacity: .84;
  }

  .armory-hero__body p {
    margin: 0;
  }

  .armory-hero__content--center .armory-hero__body {
    margin-inline: auto;
  }

  .armory-hero__actions {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .armory-hero__content--center .armory-hero__actions {
    justify-content: center;
  }

  .armory-hero__button {
    min-height: 44px;
    padding-inline: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--ah-button-bg);
    font-size: 11px;
    font-weight: 850;
    letter-spacing: .06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform .2s ease, background-color .2s ease, color .2s ease;
  }

  .armory-hero__button--primary {
    color: var(--ah-button-text);
    background: var(--ah-button-bg);
  }

  .armory-hero__button--secondary {
    color: var(--ah-body);
    background: transparent;
  }

  .armory-hero__button:hover {
    transform: translateY(-1px);
  }

  .armory-hero__button:focus-visible {
    outline: 2px solid var(--ah-accent);
    outline-offset: 3px;
  }

  .armory-hero__index {
    position: absolute;
    z-index: 2;
    width: 110px;
    height: 110px;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 4px;
    border-radius: 999px;
    color: var(--ah-body);
    background: var(--ah-badge-bg);
    border: 1px solid var(--ah-badge-border);
    text-align: center;
    backdrop-filter: blur(8px);
  }

  .armory-hero__index--bottom_right {
    right: 8vw;
    bottom: 48px;
  }

  .armory-hero__index--bottom_left {
    left: 8vw;
    bottom: 48px;
  }

  .armory-hero__index strong {
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: 22px;
    line-height: 1;
  }

  .armory-hero__index span {
    max-width: 70px;
    font-size: 9px;
    font-weight: 850;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  @media (max-width: 1023px) {
    .armory-hero h1 {
      font-size: clamp(var(--ah-heading-mobile), 9vw, var(--ah-heading-tablet));
    }
  }

  @media (max-width: 767px) {
    .armory-hero {
      min-height: var(--ah-mobile-min);
      align-items: end;
    }

    .armory-hero__shade {
      background: linear-gradient(0deg, rgba(33,8,23,.95), rgba(33,8,23,.72) 48%, rgba(33,8,23,.18));
    }

    .armory-hero__inner {
      width: min(100% - 36px, var(--page-width, 1360px));
    }

    .armory-hero__content--mobile-center {
      text-align: center;
    }

    .armory-hero__content--mobile-right {
      text-align: right;
    }

    .armory-hero__actions {
      display: grid;
    }

    .armory-hero__index {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .armory-hero__button {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Armory Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "District two" },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "Coming soon" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "The Armory" },
    { "type": "inline_richtext", "id": "accent_heading", "label": "Accent heading", "default": "awaits." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>A future collection shaped by craftsmanship, display, and samurai-inspired culture, opening as the next chapter of Gacha Treasures.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primary label", "default": "Discover what's ahead" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary label", "default": "Join the list" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "select", "id": "image_position", "label": "Image focal point", "default": "center center", "options": [
      { "value": "center center", "label": "Center" },
      { "value": "center top", "label": "Top" },
      { "value": "center bottom", "label": "Bottom" },
      { "value": "left center", "label": "Left" },
      { "value": "right center", "label": "Right" }
    ] },
    { "type": "select", "id": "content_horizontal", "label": "Content horizontal", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "select", "id": "content_vertical", "label": "Content vertical", "default": "center", "options": [
      { "value": "top", "label": "Top" },
      { "value": "center", "label": "Center" },
      { "value": "bottom", "label": "Bottom" }
    ] },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "select", "id": "mobile_text_alignment", "label": "Mobile alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "checkbox", "id": "show_index_badge", "label": "Show index badge", "default": true },
    { "type": "text", "id": "index_number", "label": "Index number", "default": "01" },
    { "type": "text", "id": "index_label", "label": "Index label", "default": "First collection information" },
    { "type": "select", "id": "index_position", "label": "Index position", "default": "bottom_right", "options": [
      { "value": "bottom_right", "label": "Bottom right" },
      { "value": "bottom_left", "label": "Bottom left" }
    ] },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 420, "max": 760, "step": 20, "unit": "px", "default": 620 },
    { "type": "range", "id": "desktop_min_height", "label": "Desktop minimum height", "min": 560, "max": 920, "step": 20, "unit": "px", "default": 760 },
    { "type": "range", "id": "mobile_min_height", "label": "Mobile minimum height", "min": 500, "max": 760, "step": 20, "unit": "px", "default": 620 },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size desktop", "min": 64, "max": 124, "step": 2, "unit": "px", "default": 100 },
    { "type": "range", "id": "heading_size_tablet", "label": "Heading size tablet", "min": 50, "max": 92, "step": 2, "unit": "px", "default": 76 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size mobile", "min": 42, "max": 64, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "heading_line_height", "label": "Heading line height", "min": 82, "max": 110, "step": 2, "unit": "%", "default": 90 },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 10, "max": 14, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "body_size", "label": "Body size", "min": 13, "max": 18, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 95, "step": 5, "unit": "%", "default": 45 },
    { "type": "color", "id": "background", "label": "Background", "default": "#210817" },
    { "type": "color", "id": "overlay_color", "label": "Overlay", "default": "#210817" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#FAF5EE" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#D692AB" },
    { "type": "color", "id": "body_color", "label": "Body", "default": "#FAF5EE" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#FAF5EE" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#210817" },
    { "type": "color", "id": "badge_background", "label": "Index background", "default": "#210817" },
    { "type": "color", "id": "badge_border", "label": "Index border", "default": "#D692AB" },
    { "type": "range", "id": "padding_top", "label": "Desktop padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Desktop padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile padding top", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile padding bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 42 }
  ],
  "presets": [
    { "name": "Armory Hero" }
  ]
}
{% endschema %}

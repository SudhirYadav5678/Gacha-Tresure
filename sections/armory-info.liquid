{% style %}
  #shopify-section-{{ section.id }} .armory-info {
    --ai-bg: {{ section.settings.background }};
    --ai-text: {{ section.settings.text_color }};
    --ai-muted: {{ section.settings.muted_text_color }};
    --ai-accent: {{ section.settings.accent_color }};
    --ai-border: {{ section.settings.divider_color }};
    --ai-heading-desktop: {{ section.settings.heading_size_desktop }}px;
    --ai-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .armory-info {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{% endstyle %}

<section class="armory-info">
  <div class="armory-info__inner armory-info__inner--{{ section.settings.content_width }}">
    <div class="armory-info__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="armory-info__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="armory-info__items">
        {% for block in section.blocks %}
          <details class="armory-info-item" {% if section.settings.open_first and forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary>
              <span>{{ block.settings.heading }}</span>
              <span aria-hidden="true">+</span>
            </summary>
            <div class="armory-info-item__content">{{ block.settings.text }}</div>
          </details>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .armory-info {
    color: var(--ai-text);
    background: var(--ai-bg);
    font-family: var(--font-body-family, Inter, ui-sans-serif, system-ui, sans-serif);
  }

  .armory-info__inner {
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(240px, .45fr) minmax(0, 1fr);
    gap: clamp(28px, 7vw, 110px);
  }

  .armory-info__inner--page {
    width: min(var(--page-width, 1360px), calc(100vw - 96px));
  }

  .armory-info__inner--narrow {
    width: min(1080px, calc(100vw - 96px));
  }

  .armory-info__eyebrow {
    margin: 0 0 18px;
    color: var(--ai-accent);
    font-size: 11px;
    font-weight: 850;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .armory-info h2 {
    margin: 0;
    color: var(--ai-text);
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(var(--ai-heading-mobile), 4vw, var(--ai-heading-desktop));
    font-weight: 500;
    line-height: 1.06;
  }

  .armory-info__items {
    border-top: 1px solid var(--ai-border);
  }

  .armory-info-item {
    border-bottom: 1px solid var(--ai-border);
  }

  .armory-info-item summary {
    min-height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    color: var(--ai-text);
    cursor: pointer;
    list-style: none;
    font-size: 15px;
    font-weight: 750;
  }

  .armory-info-item summary::-webkit-details-marker {
    display: none;
  }

  .armory-info-item summary:focus-visible {
    outline: 2px solid var(--ai-accent);
    outline-offset: 4px;
  }

  .armory-info-item[open] summary span:last-child {
    transform: rotate(45deg);
  }

  .armory-info-item summary span:last-child {
    color: var(--ai-accent);
    transition: transform .2s ease;
  }

  .armory-info-item__content {
    max-width: 760px;
    padding: 0 0 24px;
    color: var(--ai-muted);
    font-size: 14px;
    line-height: 1.75;
  }

  .armory-info-item__content p {
    margin: 0;
  }

  @media (max-width: 900px) {
    .armory-info__inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .armory-info__inner--page,
    .armory-info__inner--narrow {
      width: min(100% - 36px, var(--page-width, 1360px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .armory-info-item summary span:last-child {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Armory Info",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Before the gate opens" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Useful details for collectors." },
    { "type": "checkbox", "id": "open_first", "label": "Open first item", "default": true },
    { "type": "select", "id": "content_width", "label": "Content width", "default": "page", "options": [
      { "value": "page", "label": "Page width" },
      { "value": "narrow", "label": "Narrow" }
    ] },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size desktop", "min": 38, "max": 72, "step": 2, "unit": "px", "default": 54 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size mobile", "min": 30, "max": 50, "step": 2, "unit": "px", "default": 36 },
    { "type": "color", "id": "background", "label": "Background", "default": "#F5EEE4" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2A1722" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text", "default": "#74656C" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#C7829C" },
    { "type": "color", "id": "divider_color", "label": "Divider", "default": "#DED2C8" },
    { "type": "range", "id": "padding_top", "label": "Desktop padding top", "min": 48, "max": 140, "step": 4, "unit": "px", "default": 84 },
    { "type": "range", "id": "padding_bottom", "label": "Desktop padding bottom", "min": 48, "max": 140, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile padding top", "min": 36, "max": 90, "step": 2, "unit": "px", "default": 58 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile padding bottom", "min": 36, "max": 90, "step": 2, "unit": "px", "default": 60 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Info item",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "When will Armory District open?" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>The first categories will be announced after sourcing, availability, and responsible collection guidance are finalized.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Armory Info",
      "blocks": [
        { "type": "item", "settings": { "heading": "When will Armory District open?", "text": "<p>The first categories will be announced after sourcing, availability, and responsible collection guidance are finalized.</p>" } },
        { "type": "item", "settings": { "heading": "Will every category be available online?", "text": "<p>Some categories may have pickup, shipping, age, or regional limitations. Each release will explain the details clearly.</p>" } },
        { "type": "item", "settings": { "heading": "Is this separate from Gacha District?", "text": "<p>No. It is a quieter collector-focused chamber within the same Gacha Treasures storefront.</p>" } }
      ]
    }
  ]
}
{% endschema %}

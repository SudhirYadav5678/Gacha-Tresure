{% liquid
  assign signup_image = section.settings.image
  assign mobile_image = section.settings.mobile_image | default: signup_image
%}

{% style %}
  #shopify-section-{{ section.id }} .armory-signup {
    --asu-bg: {{ section.settings.background }};
    --asu-overlay: {{ section.settings.overlay_color }};
    --asu-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --asu-text: {{ section.settings.text_color }};
    --asu-accent: {{ section.settings.accent_color }};
    --asu-input-bg: {{ section.settings.input_background }};
    --asu-input-text: {{ section.settings.input_text_color }};
    --asu-button-bg: {{ section.settings.button_background }};
    --asu-button-text: {{ section.settings.button_text_color }};
    --asu-form-width: {{ section.settings.form_width }}px;
    --asu-min: {{ section.settings.desktop_min_height }}px;
    --asu-mobile-min: {{ section.settings.mobile_min_height }}px;
    --asu-heading-desktop: {{ section.settings.heading_size_desktop }}px;
    --asu-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .armory-signup {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{% endstyle %}

<section class="armory-signup">
  <div class="armory-signup__media" aria-hidden="true">
    {% if signup_image != blank %}
      <picture>
        {% if mobile_image != blank %}
          <source media="(max-width: 767px)" srcset="{{ mobile_image | image_url: width: 900 }}">
        {% endif %}
        {{ signup_image | image_url: width: 2200 | image_tag: widths: '720, 1000, 1400, 1800, 2200', sizes: '100vw', loading: 'lazy', class: 'armory-signup__image' }}
      </picture>
    {% endif %}
  </div>
  <div class="armory-signup__shade" aria-hidden="true"></div>
  <div class="armory-signup__inner">
    {% if section.settings.svg_icon != blank %}
      <div class="armory-signup__icon" aria-hidden="true">{{ section.settings.svg_icon }}</div>
    {% endif %}
    {% if section.settings.eyebrow != blank %}
      <p class="armory-signup__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.body != blank %}
      <div class="armory-signup__body">{{ section.settings.body }}</div>
    {% endif %}

    {% form 'customer', class: 'armory-signup__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter,armory">
      <div class="armory-signup__fields">
        <label class="armory-signup__label" for="ArmoryEmail-{{ section.id }}">{{ section.settings.email_label }}</label>
        <input
          id="ArmoryEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          placeholder="{{ section.settings.email_placeholder }}"
          required
        >
        <button type="submit">{{ section.settings.button_label }}</button>
      </div>
      {% if form.errors %}
        <div class="armory-signup__message armory-signup__message--error" role="alert">{{ form.errors | default_errors }}</div>
      {% endif %}
      {% if form.posted_successfully? %}
        <p class="armory-signup__message armory-signup__message--success" role="status">{{ section.settings.success_message }}</p>
      {% elsif section.settings.microcopy != blank %}
        <p class="armory-signup__microcopy">{{ section.settings.microcopy }}</p>
      {% endif %}
    {% endform %}
  </div>
</section>

{% stylesheet %}
  .armory-signup {
    position: relative;
    min-height: var(--asu-min);
    display: grid;
    place-items: center;
    overflow: hidden;
    color: var(--asu-text);
    background: var(--asu-bg);
    text-align: center;
    font-family: var(--font-body-family, Inter, ui-sans-serif, system-ui, sans-serif);
  }

  .armory-signup__media,
  .armory-signup__media picture,
  .armory-signup__image,
  .armory-signup__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .armory-signup__image {
    object-fit: cover;
  }

  .armory-signup__shade {
    background:
      linear-gradient(180deg, rgba(33,8,23,.52), rgba(33,8,23,.9)),
      var(--asu-overlay);
    opacity: var(--asu-overlay-opacity);
  }

  .armory-signup__inner {
    position: relative;
    z-index: 1;
    width: min(var(--asu-form-width), calc(100vw - 48px));
  }

  .armory-signup__icon {
    width: 42px;
    height: 42px;
    margin: 0 auto 16px;
    display: grid;
    place-items: center;
    color: var(--asu-accent);
    /* border: 1px solid color-mix(in srgb, var(--asu-accent) 55%, transparent); */
    border-radius: 999px;
  }

  .armory-signup__icon svg {
    width: 20px;
    height: 20px;
    /* fill: currentColor; */
  }

  .armory-signup__eyebrow {
    margin: 0 0 18px;
    color: var(--asu-text);
    font-size: 11px;
    font-weight: 850;
    letter-spacing: .16em;
    text-transform: uppercase;
    opacity: .76;
  }

  .armory-signup h2 {
    margin: 0;
    color: var(--asu-text);
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(var(--asu-heading-mobile), 5.4vw, var(--asu-heading-desktop));
    font-weight: 500;
    line-height: 1;
  }

  .armory-signup__body {
    max-width: 580px;
    margin: 20px auto 0;
    font-size: 14px;
    line-height: 1.7;
    opacity: .78;
  }

  .armory-signup__body p {
    margin: 0;
  }

  .armory-signup__form {
    margin-top: 34px;
  }

  .armory-signup__fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    min-height: 54px;
    border: 1px solid color-mix(in srgb, var(--asu-text) 20%, transparent);
    background: rgba(33,8,23,.42);
  }

  .armory-signup__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .armory-signup input {
    min-width: 0;
    width: 100%;
    border: 0;
    padding: 0 20px;
    color: var(--asu-input-text);
    background: var(--asu-input-bg);
    font: inherit;
  }

  .armory-signup input::placeholder {
    color: color-mix(in srgb, var(--asu-input-text) 62%, transparent);
  }

  .armory-signup button {
    min-width: 142px;
    border: 0;
    padding: 0 22px;
    color: var(--asu-button-text);
    background: var(--asu-button-bg);
    font: inherit;
    font-size: 12px;
    font-weight: 850;
    cursor: pointer;
    transition: filter .2s ease, transform .2s ease;
  }

  .armory-signup button:hover {
    filter: brightness(1.04);
  }

  .armory-signup input:focus-visible,
  .armory-signup button:focus-visible {
    outline: 2px solid var(--asu-accent);
    outline-offset: 3px;
  }

  .armory-signup__microcopy,
  .armory-signup__message {
    margin: 12px 0 0;
    color: var(--asu-text);
    font-size: 11px;
    line-height: 1.5;
    opacity: .72;
  }

  .armory-signup__message--success {
    color: var(--asu-accent);
    opacity: 1;
  }

  .armory-signup__message--error {
    opacity: 1;
  }

  .armory-signup__message--error ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 767px) {
    .armory-signup {
      min-height: var(--asu-mobile-min);
    }

    .armory-signup__fields {
      grid-template-columns: 1fr;
      gap: 10px;
      border: 0;
      background: transparent;
    }

    .armory-signup input,
    .armory-signup button {
      min-height: 50px;
      border: 1px solid color-mix(in srgb, var(--asu-text) 20%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .armory-signup button {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Armory Signup",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop background image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile background image" },
    { 
      "type": "html", 
      "id": "svg_icon", 
      "label": "Custom SVG Icon",
      "info": "Paste raw SVG code here. It will automatically inherit the Accent Color."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Be first through the doors" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Join the opening list." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Get early updates when the Armory District starts revealing its first collection.</p>" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email address" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Notify me" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "You are on the opening list." },
    { "type": "textarea", "id": "microcopy", "label": "Microcopy", "default": "Opening announcements begin when the district is ready." },
    { "type": "range", "id": "form_width", "label": "Form width", "min": 420, "max": 760, "step": 20, "unit": "px", "default": 620 },
    { "type": "range", "id": "desktop_min_height", "label": "Desktop minimum height", "min": 360, "max": 640, "step": 20, "unit": "px", "default": 480 },
    { "type": "range", "id": "mobile_min_height", "label": "Mobile minimum height", "min": 340, "max": 560, "step": 20, "unit": "px", "default": 420 },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size desktop", "min": 48, "max": 88, "step": 2, "unit": "px", "default": 68 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size mobile", "min": 34, "max": 58, "step": 2, "unit": "px", "default": 42 },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 95, "step": 5, "unit": "%", "default": 75 },
    { "type": "color", "id": "background", "label": "Background", "default": "#210817" },
    { "type": "color", "id": "overlay_color", "label": "Overlay", "default": "#210817" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FAF5EE" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#D692AB" },
    { "type": "color", "id": "input_background", "label": "Input background", "default": "#210817" },
    { "type": "color", "id": "input_text_color", "label": "Input text", "default": "#FAF5EE" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#D692AB" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#210817" },
    { "type": "range", "id": "padding_top", "label": "Desktop padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Desktop padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile padding top", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile padding bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 }
  ],
  "presets": [
    { "name": "Armory Signup" }
  ]
}
{% endschema %}
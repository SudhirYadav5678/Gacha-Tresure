{% comment %}
  Filename: collection-filterable-grid.liquid
  Description: A responsive collection grid with AJAX Add to Cart, client-side tag filtering, search, and specialized product card hover effects.
{% endcomment %}

<style>
  /* --- Variables & Section Setup --- */
  #shopify-section-{{ section.id }} .cg-section {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    --accent-color: {{ section.settings.accent_color }};
    --badge-bg: {{ section.settings.badge_bg_color }};
    --badge-text: {{ section.settings.badge_text_color }};
    
    --pt-desktop: {{ section.settings.padding_top }}px;
    --pb-desktop: {{ section.settings.padding_bottom }}px;
    --pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--pt-mobile);
    padding-bottom: var(--pb-mobile);
    font-family: var(--font-body-family), sans-serif;
  }

  @media screen and (min-width: 1025px) {
    #shopify-section-{{ section.id }} .cg-section {
      padding-top: var(--pt-desktop);
      padding-bottom: var(--pb-desktop);
    }
  }

  .cg-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
  }

  /* --- Toolbar (Search, Filters, Sort) --- */
  .cg-toolbar {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 20px;
  }

  @media screen and (min-width: 1025px) {
    .cg-toolbar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .cg-search {
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid var(--text-color);
    padding-bottom: 8px;
    flex: 0 0 auto;
    width: 100%;
    max-width: 250px;
  }
  
  .cg-search svg {
    width: 16px;
    height: 16px;
    color: var(--text-color);
  }

  .cg-search input {
    border: none;
    background: transparent;
    color: var(--text-color);
    font-size: 0.875rem;
    width: 100%;
    outline: none;
  }
  
  .cg-search input::placeholder {
    color: var(--text-color);
    opacity: 0.6;
  }

  .cg-filters {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    flex: 1;
    padding-bottom: 4px;
  }
  
  .cg-filters::-webkit-scrollbar { display: none; }

  .cg-filter-btn {
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-color);
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 0.75rem;
    white-space: nowrap;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  
  .cg-filter-btn:hover {
    border-color: var(--text-color);
  }

  .cg-filter-btn.active {
    background: var(--text-color);
    color: var(--bg-color);
    border-color: var(--text-color);
  }

  .cg-sort-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .cg-sort-select {
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-color);
    padding: 6px 28px 6px 12px;
    font-size: 0.75rem;
    border-radius: 2px;
    cursor: pointer;
    font-family: inherit;
    outline: none;
  }

  .cg-sort-icon {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    width: 12px;
    height: 12px;
    color: var(--text-color);
  }

  /* --- Subheader --- */
  .cg-subheader {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
    margin-bottom: 30px;
  }

  /* --- Product Grid --- */
  .cg-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px 20px;
  }

  @media screen and (min-width: 768px) {
    .cg-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 1025px) {
    .cg-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* --- Product Card (Updated for AJAX Cart & Hover Effects) --- */
  .cg-card {
    display: flex;
    flex-direction: column;
    color: inherit;
    position: relative;
  }

  .cg-card a {
    text-decoration: none;
    color: inherit;
  }

  .cg-card-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #e6e6e6;
    margin-bottom: 16px;
    overflow: hidden;
  }

  .cg-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .cg-card:hover .cg-card-image {
    transform: scale(1.03);
  }

  /* Image Hover Arrow Overlay */
  .cg-card-hover-arrow {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 32px;
    height: 32px;
    background: #ffffff;
    color: #000000;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.3s ease;
    z-index: 3;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  }

  .cg-card-hover-arrow svg {
    width: 14px;
    height: 14px;
  }

  .cg-card:hover .cg-card-hover-arrow {
    opacity: 1;
    transform: translateY(0);
  }

  .cg-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--badge-bg);
    color: var(--badge-text);
    padding: 4px 8px;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    z-index: 2;
  }

  .cg-card-vendor {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
    margin-bottom: 6px;
  }

  .cg-card-title {
    font-family: var(--font-heading-family), serif;
    font-size: 1.125rem;
    font-weight: 400;
    margin: 0 0 8px 0;
    line-height: 1.2;
  }

  .cg-card-title:hover {
    text-decoration: underline;
  }

  .cg-card-desc {
    font-size: 0.75rem;
    line-height: 1.4;
    opacity: 0.7;
    margin: 0 0 16px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cg-card-footer {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-top: 1px solid var(--border-color);
    padding-top: 12px;
  }

  .cg-card-price {
    font-size: 0.75rem;
    font-weight: 700;
  }

  .cg-card-action {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    font-size: 1.2rem;
    font-weight: 300;
    line-height: 1;
    background: transparent;
    border: none;
    color: var(--text-color);
    cursor: pointer;
    padding: 0;
    transition: opacity 0.3s;
  }

  .cg-card-action:hover {
    opacity: 0.6;
  }
  
  .cg-card-action svg {
    width: 16px;
    height: 16px;
  }

  /* Loading Spinner for Add to Cart */
  .cg-spinner {
    width: 14px;
    height: 14px;
    border: 2px solid currentColor;
    border-bottom-color: transparent;
    border-radius: 50%;
    animation: cg-spin 0.8s linear infinite;
  }

  @keyframes cg-spin {
    100% { transform: rotate(360deg); }
  }

  .cg-no-results {
    grid-column: 1 / -1;
    text-align: center;
    padding: 60px 20px;
    font-size: 1rem;
    opacity: 0.7;
    display: none;
  }
</style>

{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.product_limit
  
  # Extract unique tags for filtering
  assign all_tags = ''
  for product in collection.products limit: limit
    for tag in product.tags
      unless tag contains 'badge:' or tag contains 'Badge:'
        assign all_tags = all_tags | append: tag | append: '|||'
      endunless
    endfor
  endfor
  
  assign unique_tags = all_tags | split: '|||' | uniq | compact
-%}

<div class="cg-section" data-section-id="{{ section.id }}">
  <div class="cg-container">
    
    <!-- Toolbar -->
    <div class="cg-toolbar">
      {% if section.settings.show_search %}
        <div class="cg-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input type="text" placeholder="Search the district" class="js-cg-search-input" aria-label="Search products">
        </div>
      {% endif %}

      <div class="cg-filters js-cg-filters">
        <button class="cg-filter-btn active" data-tag="all">All finds</button>
        {% for tag in unique_tags limit: 8 %}
          <button class="cg-filter-btn" data-tag="{{ tag | handleize }}">{{ tag }}</button>
        {% endfor %}
      </div>

      {% if section.settings.show_sort %}
        <div class="cg-sort-wrapper">
          <select class="cg-sort-select js-cg-sort" aria-label="Sort products">
            <option value="featured">Sort: Featured</option>
            <option value="price-asc">Price: Low to High</option>
            <option value="price-desc">Price: High to Low</option>
            <option value="alpha-asc">Alphabetically: A-Z</option>
            <option value="alpha-desc">Alphabetically: Z-A</option>
          </select>
          <svg class="cg-sort-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </div>
      {% endif %}
    </div>

    <!-- Subheader -->
    <div class="cg-subheader">
      <div class="cg-count">
        <span class="js-cg-count">{{ collection.products_count | default: 8 }}</span> FEATURED FINDS - MORE ARRIVING SOON
      </div>
      {% if section.settings.subheader_label != blank %}
        <div class="cg-label hidden-mobile">{{ section.settings.subheader_label }}</div>
      {% endif %}
    </div>

    <!-- Product Grid -->
    <div class="cg-grid js-cg-grid">
      {% if collection != blank and collection.products_count > 0 %}
        {% for product in collection.products limit: limit %}
          {%- liquid
            # Proper Liquid loop for handleizing an array of tags
            assign product_tags_handleized = ''
            for tag in product.tags
              assign h_tag = tag | handleize
              assign product_tags_handleized = product_tags_handleized | append: h_tag | append: ','
            endfor
            
            assign badge_text = blank
            for tag in product.tags
              if tag contains 'Badge:' or tag contains 'badge:'
                assign badge_text = tag | split: ':' | last | strip
                break
              endif
            endfor
          -%}

          <div class="cg-card js-cg-card" 
               data-tags="{{ product_tags_handleized }}" 
               data-title="{{ product.title | downcase }}"
               data-price="{{ product.price_min }}"
               data-index="{{ forloop.index }}">
            
            <a href="{{ product.url }}" class="cg-card-image-link">
              <div class="cg-card-image-wrapper">
                {% if badge_text != blank %}
                  <span class="cg-badge">{{ badge_text }}</span>
                {% endif %}
                
                <div class="cg-card-hover-arrow">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                </div>
                
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 800 | image_tag: 
                    class: 'cg-card-image', 
                    loading: 'lazy', 
                    sizes: '(min-width: 1025px) 25vw, (min-width: 768px) 50vw, 100vw'
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'cg-card-image placeholder' }}
                {% endif %}
              </div>
            </a>
            
            <div class="cg-card-info">
              <div class="cg-card-vendor">{{ product.tags.first }}</div>
              <a href="{{ product.url }}"><h3 class="cg-card-title">{{ product.title }}</h3></a>
              
              {% if product.description != blank %}
                <div class="cg-card-desc">{{ product.description | strip_html | truncate: 70 }}</div>
              {% endif %}
            </div>

            <div class="cg-card-footer">
              <span class="cg-card-price">
                {% if product.price_varies %}From {% endif %}
                {{ product.price_min | money_without_trailing_zeros }}
              </span>
              
              {% if product.has_only_default_variant or product.available %}
                <button type="button" class="cg-card-action js-add-to-cart" data-variant-id="{{ product.selected_or_first_available_variant.id }}" aria-label="Add to cart">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                </button>
              {% else %}
                <a href="{{ product.url }}" class="cg-card-action" aria-label="View product">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                </a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Mockup Data for Onboarding -->
        {% for i in (1..4) %}
          <div class="cg-card js-cg-card" data-tags="gashapon,blind-boxes" data-title="mystery item {{ i }}" data-price="800" data-index="{{ forloop.index }}">
            <a href="#" class="cg-card-image-link">
              <div class="cg-card-image-wrapper">
                <span class="cg-badge">THE SIGNATURE PULL</span>
                <div class="cg-card-hover-arrow">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                </div>
                {{ 'product-' | append: i | placeholder_svg_tag: 'cg-card-image placeholder' }}
              </div>
            </a>
            <div class="cg-card-info">
              <div class="cg-card-vendor">GASHAPON</div>
              <a href="#"><h3 class="cg-card-title">Mystery Gashapon Capsule</h3></a>
              <div class="cg-card-desc">Choose a capsule size. We choose the surprise.</div>
            </div>
            <div class="cg-card-footer">
              <span class="cg-card-price">From $8</span>
              <button class="cg-card-action">+</button>
            </div>
          </div>
        {% endfor %}
      {% endif %}

      <div class="cg-no-results js-cg-no-results">
        No finds match your current selection.
      </div>
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;

    // --- Filtering & Sorting ---
    const filterBtns = section.querySelectorAll('.cg-filter-btn');
    const searchInput = section.querySelector('.js-cg-search-input');
    const sortSelect = section.querySelector('.js-cg-sort');
    const grid = section.querySelector('.js-cg-grid');
    const cards = section.querySelectorAll('.js-cg-card');
    const noResultsMsg = section.querySelector('.js-cg-no-results');
    const countDisplay = section.querySelector('.js-cg-count');
    
    let cardsArray = Array.from(cards);
    let currentTag = 'all';
    let currentSearch = '';

    function filterCards() {
      let visibleCount = 0;
      cardsArray.forEach(card => {
        const cardTags = card.dataset.tags ? card.dataset.tags.split(',') : [];
        const cardTitle = card.dataset.title || '';
        const matchesTag = currentTag === 'all' || cardTags.includes(currentTag);
        const matchesSearch = currentSearch === '' || cardTitle.includes(currentSearch);

        if (matchesTag && matchesSearch) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });
      if (countDisplay) countDisplay.textContent = visibleCount;
      noResultsMsg.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    function sortCards(method) {
      cardsArray.sort((a, b) => {
        if (method === 'price-asc') return parseFloat(a.dataset.price) - parseFloat(b.dataset.price);
        if (method === 'price-desc') return parseFloat(b.dataset.price) - parseFloat(a.dataset.price);
        if (method === 'alpha-asc') return a.dataset.title.localeCompare(b.dataset.title);
        if (method === 'alpha-desc') return b.dataset.title.localeCompare(a.dataset.title);
        return parseInt(a.dataset.index) - parseInt(b.dataset.index); // Default
      });
      cardsArray.forEach(card => grid.insertBefore(card, noResultsMsg));
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        filterBtns.forEach(b => b.classList.remove('active'));
        e.target.classList.add('active');
        currentTag = e.target.dataset.tag;
        filterCards();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentSearch = e.target.value.toLowerCase().trim();
        filterCards();
      });
    }

    if (sortSelect) {
      sortSelect.addEventListener('change', (e) => sortCards(e.target.value));
    }

    // --- AJAX Add to Cart ---
    const addToCartBtns = section.querySelectorAll('.js-add-to-cart');
    
    addToCartBtns.forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const variantId = btn.dataset.variantId;
        if (!variantId) return;

        const originalContent = btn.innerHTML;
        btn.innerHTML = '<div class="cg-spinner"></div>';
        btn.disabled = true;

        try {
          // Add to cart
          const response = await fetch(window.Shopify.routes.root + 'cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
          });

          if (!response.ok) throw new Error('Error adding to cart');

          // Fetch updated cart data
          const cartRes = await fetch(window.Shopify.routes.root + 'cart.js');
          const cartData = await cartRes.json();

          // Update standard Shopify header cart counters (Dawn / most themes)
          document.querySelectorAll('.cart-count-bubble span:first-child, #cart-icon-bubble .cart-count-bubble, .header__cart-count').forEach(el => {
            el.textContent = cartData.item_count;
            el.classList.remove('hidden'); // In case it was hidden when empty
          });

          // Dispatch standard events for theme specific mini-carts to open
          document.dispatchEvent(new CustomEvent('cart:build'));
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: cartData } }));
          document.dispatchEvent(new CustomEvent('ajaxProduct:added', { detail: { product: cartData } }));

          // Success feedback
          btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>';
          
          setTimeout(() => {
            btn.innerHTML = originalContent;
            btn.disabled = false;
          }, 2000);

        } catch (error) {
          console.error(error);
          btn.innerHTML = '<span style="font-size: 14px;">!</span>'; // Error state
          setTimeout(() => {
            btn.innerHTML = originalContent;
            btn.disabled = false;
          }, 2000);
        }
      });
    });
  });
</script>

{% schema %}
{

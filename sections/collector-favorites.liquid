{% comment %}
  Filename: collector-favorites.liquid
  Description: A responsive horizontal scrolling collection slider with a sticky informational sidebar.
{% endcomment %}

<style>
  /* --- Scoped CSS --- */
  .cf-section-{{ section.id }} {
    display: block; /* Critical fix: Custom elements are inline by default */
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --card-bg-color: {{ section.settings.card_bg_color }};
    --card-text-color: {{ section.settings.card_text_color }};
    
    --pt-desktop: {{ section.settings.padding_top }}px;
    --pb-desktop: {{ section.settings.padding_bottom }}px;
    --pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--pt-mobile);
    padding-bottom: var(--pb-mobile);
    overflow: hidden;
  }

  @media screen and (min-width: 1025px) {
    .cf-section-{{ section.id }} {
      padding-top: var(--pt-desktop);
      padding-bottom: var(--pb-desktop);
    }
  }

  .cf-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
  }

  .cf-grid {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  @media screen and (min-width: 1025px) {
    .cf-grid {
      flex-direction: row;
      align-items: center;
      gap: 60px;
    }
  }

  /* --- Sidebar / Info --- */
  .cf-sidebar {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  @media screen and (min-width: 1025px) {
    .cf-sidebar {
      flex: 0 0 280px;
    }
  }

  .cf-heading {
    margin: 0;
    font-family: var(--font-heading-family), serif;
    font-size: {{ section.settings.heading_size_mobile }}px;
    font-weight: 400;
    line-height: 1.1;
    color: var(--text-color);
    white-space: pre-line;
  }
  .cf-heading em{
    color: #EDABC6;
  }

  @media screen and (min-width: 768px) {
    .cf-heading {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }
  }

  .cf-description {
    font-size: 0.875rem;
    line-height: 1.5;
    opacity: 0.9;
    max-width: 400px;
  }
  .cf-description p { margin: 0; }

  .cf-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-color);
    text-decoration: none;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: opacity 0.3s ease, gap 0.3s ease;
    margin-bottom: 10px;
  }

  .cf-link:hover {
    opacity: 0.7;
    gap: 12px;
  }

  /* Navigation Arrows */
  .cf-nav {
    display: flex;
    gap: 12px;
    margin-top: 10px;
  }

  .cf-nav-btn {
    background: transparent;
    border: 1px solid rgba(255,255,255,0.15);
    color: var(--text-color);
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.3s, border-color 0.3s;
    padding: 0;
  }

  .cf-nav-btn:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.4);
  }

  .cf-nav-btn svg {
    width: 16px;
    height: 16px;
  }

  /* --- Carousel / Slider --- */
  .cf-carousel-wrapper {
    flex: 1;
    min-width: 0;
    width: 100%;
  }

  .cf-carousel {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge */
    padding-bottom: 20px;
    margin-bottom: -20px;
  }

  .cf-carousel::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  /* --- Product Card --- */
  .cf-card {
    flex: 0 0 280px;
    scroll-snap-align: start;
    background-color: var(--card-bg-color);
    color: var(--card-text-color);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  @media screen and (min-width: 768px) {
    .cf-card {
      flex: 0 0 300px;
    }
  }

  .cf-card:hover {
    transform: translateY(-4px);
  }

  .cf-card-image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1.05;
    overflow: hidden;
    background: #e6e6e6;
  }

  .cf-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .cf-card:hover .cf-card-image {
    transform: scale(1.03);
  }

  .cf-card-content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .cf-card-tag {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: inherit; 
    opacity: 0.6;
    margin-bottom: 8px;
  }

  .cf-card-title {
    font-family: var(--font-heading-family), serif;
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.3;
    margin: 0 0 24px 0;
    color: var(--card-text-color);
  }

  .cf-card-footer {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .cf-card-price {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--card-text-color);
  }

  .cf-card-action {
    font-size: 0.75rem;
    color: var(--card-text-color);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    opacity: 0.7;
    transition: opacity 0.3s;
  }

  .cf-card:hover .cf-card-action {
    opacity: 1;
  }
</style>

<collector-favorites-element class="cf-section-{{ section.id }}">
  <div class="cf-container">
    <div class="cf-grid">
      
      <!-- Sidebar Info -->
      <div class="cf-sidebar">
        {% if section.settings.heading != blank %}
          <h2 class="cf-heading">{{ section.settings.heading | newline_to_br }}</h2>
        {% endif %}
        
        {% if section.settings.description != blank %}
          <div class="cf-description">
            {{ section.settings.description }}
          </div>
        {% endif %}
        
        {% if section.settings.link_text != blank %}
          <a href="{{ section.settings.link_url | default: '#' }}" class="cf-link">
            {{ section.settings.link_text }}
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
            </svg>
          </a>
        {% endif %}

        <div class="cf-nav" aria-hidden="true">
          <button class="cf-nav-btn cf-prev" aria-label="Previous">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M13 7H1M1 7L7 13M1 7L7 1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button class="cf-nav-btn cf-next" aria-label="Next">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 7H13M13 7L7 13M13 7L7 1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Carousel -->
      <div class="cf-carousel-wrapper">
        <div class="cf-carousel">
          
          {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
            {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
              <a href="{{ product.url }}" class="cf-card">
                <div class="cf-card-image-wrapper">
                  {%- if product.featured_image != blank -%}
                    {{ product.featured_image | image_url: width: 600 | image_tag: 
                      class: 'cf-card-image', 
                      loading: 'lazy', 
                      sizes: '(min-width: 1025px) 300px, 280px', 
                      widths: '280, 300, 560, 600' 
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'cf-card-image' }}
                  {%- endif -%}
                </div>
                
                <div class="cf-card-content">
                  {%- if product.tags.size > 0 -%}
                    <div class="cf-card-tag">{{ product.tags.first }}</div>
                  {%- endif -%}
                  <h3 class="cf-card-title">{{ product.title }}</h3>
                  
                  <div class="cf-card-footer">
                    <span class="cf-card-price">{{ product.price | money_without_trailing_zeros }}</span>
                    <span class="cf-card-action">View product &rarr;</span>
                  </div>
                </div>
              </a>
            {%- endfor -%}

          {%- else -%}
            <!-- Fallback Mockup Data (Onboarding) -->
            {%- assign onboarding_data = "GASHAPON|Mystery Gashapon Capsule|$8,BLIND BOXES|Sakura Night Blind Box|$16,KEYCHAINS|Lucky Cat Pocket Charm|$12,DIY MINIATURES|DIY Miniature Building Kit|$34" | split: "," -%}
            
            {%- for item in onboarding_data -%}
              {%- assign item_split = item | split: "|" -%}
              <a href="#" class="cf-card">
                <div class="cf-card-image-wrapper">
                  {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'cf-card-image' }}
                </div>
                <div class="cf-card-content">
                  <div class="cf-card-tag">{{ item_split[0] }}</div>
                  <h3 class="cf-card-title">{{ item_split[1] }}</h3>
                  <div class="cf-card-footer">
                    <span class="cf-card-price">{{ item_split[2] }}</span>
                    <span class="cf-card-action">View product &rarr;</span>
                  </div>
                </div>
              </a>
            {%- endfor -%}
          {%- endif -%}

        </div>
      </div>

    </div>
  </div>
</collector-favorites-element>

<script>
  if (!customElements.get('collector-favorites-element')) {
    class CollectorFavoritesElement extends HTMLElement {
      constructor() {
        super();
        this.slider = this.querySelector('.cf-carousel');
        this.btnPrev = this.querySelector('.cf-prev');
        this.btnNext = this.querySelector('.cf-next');

        if (this.btnPrev && this.btnNext && this.slider) {
          this.btnPrev.addEventListener('click', () => this.scroll(-1));
          this.btnNext.addEventListener('click', () => this.scroll(1));
        }
      }

      scroll(direction) {
        const firstCard = this.slider.querySelector('.cf-card');
        if (firstCard) {
          // Calculate scroll distance: card width + gap (20px)
          const scrollAmount = (firstCard.offsetWidth + 20) * direction;
          this.slider.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        }
      }
    }
    customElements.define('collector-favorites-element', CollectorFavoritesElement);
  }
</script>


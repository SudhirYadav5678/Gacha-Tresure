{% style %}
  #shopify-section-{{ section.id }} .contact-split {
    --cs-bg: {{ section.settings.background }};
    --cs-heading: {{ section.settings.heading_color }};
    --cs-accent: {{ section.settings.accent_color }};
    --cs-body: {{ section.settings.body_color }};
    --cs-notice-bg: {{ section.settings.notice_background }};
    --cs-form-bg: {{ section.settings.form_background }};
    --cs-input-bg: {{ section.settings.input_background }};
    --cs-input-text: {{ section.settings.input_text_color }};
    --cs-input-border: {{ section.settings.input_border }};
    --cs-button-bg: {{ section.settings.button_background }};
    --cs-button-text: {{ section.settings.button_text_color }};
    --cs-shadow: {{ section.settings.shadow_strength | divided_by: 100.0 }};
    --cs-radius: {{ section.settings.card_radius }}px;
    --cs-gap: {{ section.settings.column_gap }}px;
    --cs-left: {{ section.settings.left_column }}fr;
    --cs-right: {{ section.settings.right_column }}fr;
    --cs-heading-desktop: {{ section.settings.heading_size_desktop }}px;
    --cs-heading-mobile: {{ section.settings.heading_size_mobile }}px;

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .contact-split {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{% endstyle %}


<section class="contact-split" id="contact">

  <div
    class="
      contact-split__inner
      contact-split__inner--{{ section.settings.content_width }}
      contact-split__inner--{{ section.settings.vertical_alignment }}
    "
  >

    <!-- LEFT CONTENT -->
    <div class="contact-split__content">

      {% if section.settings.eyebrow != blank %}
        <p class="contact-split__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}


      {% if section.settings.heading != blank or section.settings.accent_heading != blank %}
        <h2>
          {% if section.settings.heading != blank %}
            <span>{{ section.settings.heading }}</span>
          {% endif %}

          {% if section.settings.accent_heading != blank %}
            <em>{{ section.settings.accent_heading }}</em>
          {% endif %}
        </h2>
      {% endif %}


      {% if section.settings.body != blank %}
        <div class="contact-split__body">
          {{ section.settings.body }}
        </div>
      {% endif %}


      {% if section.settings.notice != blank %}
        <div class="contact-split__notice">
          {{ section.settings.notice }}
        </div>
      {% endif %}


      <!-- SOCIAL LINKS -->
      {% liquid
        assign has_social = false

        for block in section.blocks
          if block.type == 'social' and block.settings.url != blank
            assign has_social = true
          endif
        endfor
      %}


      {% if has_social %}

        <div
          class="contact-split__social"
          aria-label="{{ section.settings.social_label | escape }}"
        >

          {% for block in section.blocks %}

            {% if block.type == 'social' and block.settings.url != blank %}

              {% assign social_name = block.settings.social_type | downcase | strip %}

              <a
                class="contact-split__social-link"
                href="{{ block.settings.url }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="{{ block.settings.label | escape }}"
                {{ block.shopify_attributes }}
              >

                <span
                  class="contact-split__social-icon"
                  aria-hidden="true"
                >

                  <!-- INSTAGRAM -->
                  {% if social_name contains 'instagram' %}

                    <svg
                      viewBox="0 0 24 24"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                    >
                      <rect
                        x="3.25"
                        y="3.25"
                        width="17.5"
                        height="17.5"
                        rx="5"
                        stroke="currentColor"
                        stroke-width="1.7"
                      />

                      <circle
                        cx="12"
                        cy="12"
                        r="4"
                        stroke="currentColor"
                        stroke-width="1.7"
                      />

                      <circle
                        cx="17.35"
                        cy="6.7"
                        r="1.1"
                        fill="currentColor"
                      />
                    </svg>


                  <!-- TIKTOK -->
                  {% elsif social_name contains 'tiktok' or social_name contains 'tik tok' %}

                    <svg
                      viewBox="0 0 24 24"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="currentColor"
                    >
                      <path
                        d="M15.25 3c.16 1.27.66 2.28 1.5 3.03.79.7 1.77 1.1 2.95 1.2v2.77c-1.64-.05-3.11-.55-4.45-1.5v6.2c0 3.48-2.63 6.3-6.08 6.3A6.15 6.15 0 0 1 3 14.82a6.15 6.15 0 0 1 6.17-6.15c.38 0 .75.03 1.12.1v2.85a3.4 3.4 0 0 0-1.12-.19 3.38 3.38 0 1 0 3.38 3.39V3h2.7Z"
                      />
                    </svg>


                  <!-- FACEBOOK -->
                  {% elsif social_name contains 'facebook' %}

                    <svg
                      viewBox="0 0 24 24"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="currentColor"
                    >
                      <path
                        d="M13.72 21v-8.2h2.78l.42-3.2h-3.2V7.56c0-.93.26-1.56 1.6-1.56h1.71V3.14A23.4 23.4 0 0 0 14.54 3c-2.47 0-4.16 1.51-4.16 4.29V9.6H7.58v3.2h2.8V21h3.34Z"
                      />
                    </svg>


                  <!-- YOUTUBE -->
                  {% elsif social_name contains 'youtube' %}

                    <svg
                      viewBox="0 0 24 24"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                    >
                      <path
                        d="M21.28 7.31a2.86 2.86 0 0 0-2.01-2.03C17.5 4.8 12 4.8 12 4.8s-5.5 0-7.27.48a2.86 2.86 0 0 0-2.01 2.03A29.8 29.8 0 0 0 2.24 12c0 1.58.16 3.15.48 4.69a2.86 2.86 0 0 0 2.01 2.03c1.77.48 7.27.48 7.27.48s5.5 0 7.27-.48a2.86 2.86 0 0 0 2.01-2.03c.32-1.54.48-3.11.48-4.69s-.16-3.15-.48-4.69Z"
                        fill="currentColor"
                      />

                      <path
                        d="M10 8.65v6.7L15.5 12 10 8.65Z"
                        fill="white"
                      />
                    </svg>


                  <!-- PINTEREST -->
                  {% elsif social_name contains 'pinterest' %}

                    <svg
                      viewBox="0 0 24 24"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="currentColor"
                    >
                      <path
                        d="M12 2.5A9.5 9.5 0 0 0 8.54 20.85c-.08-1.55-.02-3.4.4-5.15l1.21-5.16s-.31-.62-.31-1.55c0-1.45.84-2.55 1.91-2.55.9 0 1.33.68 1.33 1.49 0 .9-.57 2.25-.87 3.5-.25 1.04.52 1.88 1.55 1.88 1.86 0 3.29-1.96 3.29-4.8 0-2.5-1.8-4.26-4.39-4.26-2.98 0-4.73 2.24-4.73 4.56 0 .9.35 1.87.78 2.4.08.1.1.2.07.31l-.3 1.24c-.04.2-.15.25-.35.15-1.33-.62-2.16-2.55-2.16-4.1 0-3.34 2.43-6.42 7.02-6.42 3.68 0 6.55 2.62 6.55 6.13 0 3.67-2.31 6.63-5.51 6.63-1.08 0-2.09-.56-2.44-1.22l-.66 2.52c-.24.92-.88 2.07-1.32 2.77.99.31 2.05.48 3.16.48A9.5 9.5 0 0 0 12 2.5Z"
                      />
                    </svg>


                  <!-- X / TWITTER -->
                  {% elsif social_name == 'x' or social_name contains 'twitter' %}

                    <svg
                      viewBox="0 0 24 24"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="currentColor"
                    >
                      <path
                        d="M5.25 4h4.27l3.36 4.5L16.78 4h1.96l-4.95 5.93L19.5 20h-4.26l-3.89-5.2L7 20H5.04l5.4-6.64L5.25 4Zm3.34 1.55H7.97l8.35 12.91h.61L8.59 5.55Z"
                      />
                    </svg>


                  <!-- LINKEDIN -->
                  {% elsif social_name contains 'linkedin' %}

                    <svg
                      viewBox="0 0 24 24"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="currentColor"
                    >
                      <path
                        d="M5.4 3.8a2.1 2.1 0 1 1 0 4.2 2.1 2.1 0 0 1 0-4.2ZM3.6 9.6h3.6V20H3.6V9.6Zm5.8 0h3.45v1.42h.05c.48-.91 1.65-1.87 3.4-1.87 3.64 0 4.31 2.4 4.31 5.51V20h-3.6v-4.73c0-1.13-.02-2.58-1.57-2.58-1.58 0-1.82 1.23-1.82 2.5V20H9.4V9.6Z"
                      />
                    </svg>


                  <!-- GENERIC LINK -->
                  {% else %}

                    <svg
                      viewBox="0 0 24 24"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                    >
                      <path
                        d="M9.4 14.6 14.6 9.4"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                      />

                      <path
                        d="M7.1 16.9 5.7 18.3a3.25 3.25 0 0 1-4.6-4.6l3.3-3.3a3.25 3.25 0 0 1 4.6 0"
                        transform="translate(3 0)"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                      />

                      <path
                        d="m13.9 7.1 1.4-1.4a3.25 3.25 0 0 1 4.6 4.6l-3.3 3.3a3.25 3.25 0 0 1-4.6 0"
                        transform="translate(-1 0)"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                      />
                    </svg>

                  {% endif %}

                </span>

              </a>

            {% endif %}

          {% endfor %}

        </div>

      {% endif %}

    </div>


    <!-- CONTACT FORM - Shopify native contact form -->
    <div class="contact-split__card">

      {% form 'contact', class: 'contact-split__form' %}

        {% if form.posted_successfully? %}

          <div
            class="contact-split__success"
            role="status"
          >
            <h3>{{ section.settings.success_heading }}</h3>
            <p>{{ section.settings.success_message }}</p>
          </div>

        {% endif %}


        {% if form.errors %}

          <div
            class="contact-split__errors"
            role="alert"
          >
            {{ form.errors | default_errors }}
          </div>

        {% endif %}


        <div class="contact-split__row">

          <div class="contact-split__field">

            <label for="ContactName-{{ section.id }}">
              {{ section.settings.name_label }}
            </label>

            <input
              id="ContactName-{{ section.id }}"
              type="text"
              name="contact[name]"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              autocomplete="name"
              placeholder="{{ section.settings.name_placeholder | escape }}"
            >

          </div>


          <div class="contact-split__field">

            <label for="ContactEmail-{{ section.id }}">
              {{ section.settings.email_label }}
            </label>

            <input
              id="ContactEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              autocomplete="email"
              placeholder="{{ section.settings.email_placeholder | escape }}"
              required
            >

          </div>

        </div>


        {% if section.settings.enable_phone or section.settings.enable_order_number %}

          <div class="contact-split__row">

            {% if section.settings.enable_phone %}

              <div class="contact-split__field">

                <label for="ContactPhone-{{ section.id }}">
                  {{ section.settings.phone_label }}
                </label>

                <input
                  id="ContactPhone-{{ section.id }}"
                  type="tel"
                  name="contact[phone]"
                  autocomplete="tel"
                  placeholder="{{ section.settings.phone_placeholder | escape }}"
                >

              </div>

            {% endif %}


            {% if section.settings.enable_order_number %}

              <div class="contact-split__field">

                <label for="ContactOrder-{{ section.id }}">
                  {{ section.settings.order_label }}
                </label>

                <input
                  id="ContactOrder-{{ section.id }}"
                  type="text"
                  name="contact[Order number]"
                  placeholder="{{ section.settings.order_placeholder | escape }}"
                >

              </div>

            {% endif %}

          </div>

        {% endif %}


        <div class="contact-split__field">

          <label for="ContactTopic-{{ section.id }}">
            {{ section.settings.topic_label }}
          </label>


          <select
            id="ContactTopic-{{ section.id }}"
            name="contact[Topic]"
          >

            {% liquid
              assign has_topics = false

              for block in section.blocks
                if block.type == 'topic'
                  assign has_topics = true
                endif
              endfor
            %}


            {% if has_topics %}

              {% for block in section.blocks %}

                {% if block.type == 'topic' %}

                  <option value="{{ block.settings.value | escape }}">
                    {{ block.settings.label }}
                  </option>

                {% endif %}

              {% endfor %}

            {% else %}

              <option value="General question">
                {{ section.settings.topic_placeholder }}
              </option>

            {% endif %}

          </select>

        </div>


        {% if section.settings.enable_preferred_location %}

          <div class="contact-split__field">

            <label for="ContactLocation-{{ section.id }}">
              {{ section.settings.preferred_location_label }}
            </label>

            <input
              id="ContactLocation-{{ section.id }}"
              type="text"
              name="contact[Preferred location]"
              placeholder="{{ section.settings.preferred_location_placeholder | escape }}"
            >

          </div>

        {% endif %}


        <div class="contact-split__field">

          <label for="ContactMessage-{{ section.id }}">
            {{ section.settings.message_label }}
          </label>

          <textarea
            id="ContactMessage-{{ section.id }}"
            name="contact[body]"
            rows="7"
            placeholder="{{ section.settings.message_placeholder | escape }}"
            required
          >{% if form.body %}{{ form.body }}{% endif %}</textarea>

        </div>


        <div class="contact-split__footer">

          {% if section.settings.form_note != blank %}

            <p>
              {{ section.settings.form_note }}
            </p>

          {% endif %}


          <button type="submit">
            {{ section.settings.button_label }}
          </button>

        </div>

      {% endform %}

    </div>

  </div>

</section>


{% stylesheet %}

  .contact-split {
    color: var(--cs-body);
    background: var(--cs-bg);
    font-family:
      var(--font-body-family),
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
  }


  .contact-split * {
    box-sizing: border-box;
  }


  .contact-split__inner {
    margin-inline: auto;

    display: grid;
    grid-template-columns:
      minmax(0, var(--cs-left))
      minmax(0, var(--cs-right));

    gap: var(--cs-gap);
  }


  .contact-split__inner--page {
    width: min(
      var(--page-width, 1360px),
      calc(100vw - 96px)
    );
  }


  .contact-split__inner--wide {
    width: min(
      1560px,
      calc(100vw - 64px)
    );
  }


  .contact-split__inner--top {
    align-items: start;
  }


  .contact-split__inner--center {
    align-items: center;
  }


  .contact-split__eyebrow {
    margin: 0 0 20px;

    color: var(--cs-body);

    font-size: 11px;
    font-weight: 850;

    letter-spacing: 0.16em;
    text-transform: uppercase;
  }


  .contact-split h2 {
    margin: 0;

    color: var(--cs-heading);

    font-family:
      var(--font-heading-family),
      Georgia,
      serif;

    font-size: clamp(
      var(--cs-heading-mobile),
      4.9vw,
      var(--cs-heading-desktop)
    );

    font-weight: 500;
    line-height: 1.02;
  }


  .contact-split h2 span,
  .contact-split h2 em {
    display: block;
  }


  .contact-split h2 em {
    color: var(--cs-accent);
    font-style: italic;
  }


  .contact-split__body {
    max-width: 560px;

    margin-top: 26px;

    font-size: 15px;
    line-height: 1.75;

    opacity: 0.82;
  }


  .contact-split__body p,
  .contact-split__notice p,
  .contact-split__footer p,
  .contact-split__success p {
    margin: 0;
  }


  .contact-split__notice {
    max-width: 620px;

    margin-top: 34px;
    padding: 22px 24px;

    color: var(--cs-body);
    background: var(--cs-notice-bg);

    border-left: 3px solid var(--cs-accent);

    font-size: 14px;
    line-height: 1.65;
  }


  /* ========================================
     SOCIAL LINKS
  ======================================== */

  .contact-split__social {
    margin-top: 28px;

    display: flex;
    align-items: center;
    flex-wrap: wrap;

    gap: 10px;
  }


  .contact-split__social-link {
    width: 50px;
    height: 50px;

    padding: 0;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    color: var(--cs-heading);
    background: #ffffff;

    border: 1px solid var(--cs-input-border);

    line-height: 1;
    text-decoration: none;

    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }


  .contact-split__social-link:hover {
    color: var(--cs-accent);

    border-color: var(--cs-accent);

    transform: translateY(-1px);
  }


  .contact-split__social-icon {
    width: 25px;
    height: 25px;

    flex: 0 0 25px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    color: currentColor;
  }


  .contact-split__social-icon svg {
    width: 25px;
    height: 25px;

    display: block;

    overflow: visible;
  }


  /* ========================================
     FORM CARD
  ======================================== */

  .contact-split__card {
    min-width: 0;

    background: var(--cs-form-bg);

    border: 1px solid var(--cs-input-border);
    border-radius: var(--cs-radius);

    box-shadow:
      0 24px 70px
      rgba(45, 23, 35, var(--cs-shadow));
  }


  .contact-split__form {
    padding: clamp(24px, 4vw, 48px);
  }


  .contact-split__row {
    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 18px;
  }


  .contact-split__field {
    margin-bottom: 20px;
  }


  .contact-split__field label {
    display: block;

    margin-bottom: 8px;

    color: var(--cs-heading);

    font-size: 11px;
    font-weight: 850;

    letter-spacing: 0.12em;
    text-transform: uppercase;
  }


  .contact-split input,
  .contact-split select,
  .contact-split textarea {
    width: 100%;

    min-height: 50px;

    padding: 0 16px;

    color: var(--cs-input-text);
    background: var(--cs-input-bg);

    border: 1px solid var(--cs-input-border);
    border-radius: 0;

    font: inherit;
  }


  .contact-split textarea {
    min-height: 148px;

    padding-top: 16px;
    padding-bottom: 16px;

    resize: vertical;
  }


  .contact-split input:focus-visible,
  .contact-split select:focus-visible,
  .contact-split textarea:focus-visible,
  .contact-split button:focus-visible,
  .contact-split__social-link:focus-visible {
    outline: 2px solid var(--cs-accent);
    outline-offset: 3px;
  }


  .contact-split__footer {
    display: flex;

    justify-content: space-between;
    align-items: center;

    gap: 22px;
  }


  .contact-split__footer p {
    max-width: 520px;

    font-size: 12px;
    line-height: 1.55;

    opacity: 0.72;
  }


  .contact-split button {
    min-height: 48px;
    min-width: 150px;

    padding: 0 24px;

    color: var(--cs-button-text);
    background: var(--cs-button-bg);

    border: 1px solid var(--cs-button-bg);

    font: inherit;
    font-size: 12px;
    font-weight: 850;

    cursor: pointer;

    transition:
      transform 0.2s ease,
      filter 0.2s ease;
  }


  .contact-split button:hover {
    transform: translateY(-1px);
    filter: brightness(1.04);
  }


  .contact-split__errors,
  .contact-split__success {
    margin-bottom: 24px;

    padding: 16px 18px;

    border: 1px solid var(--cs-input-border);

    background: var(--cs-notice-bg);
  }


  .contact-split__success h3 {
    margin: 0 0 6px;

    color: var(--cs-heading);

    font-family:
      var(--font-heading-family),
      Georgia,
      serif;

    font-size: 24px;
  }


  .contact-split__errors ul {
    margin: 0;

    padding-left: 18px;
  }


  /* ========================================
     TABLET
  ======================================== */

  @media (max-width: 980px) {

    .contact-split__inner {
      grid-template-columns: 1fr;
    }

  }


  /* ========================================
     MOBILE
  ======================================== */

  @media (max-width: 767px) {

    .contact-split__inner--page,
    .contact-split__inner--wide {
      width: min(
        calc(100% - 36px),
        var(--page-width, 1360px)
      );
    }


    .contact-split__row {
      grid-template-columns: 1fr;
    }


    .contact-split__footer {
      display: grid;
      grid-template-columns: 1fr;
    }


    .contact-split button {
      width: 100%;
    }


    .contact-split__social {
      display: flex;
      flex-wrap: wrap;

      gap: 8px;
    }


    .contact-split__social-link {
      width: 46px;
      height: 46px;

      padding: 0;
    }


    .contact-split__social-icon {
      width: 23px;
      height: 23px;

      flex-basis: 23px;
    }


    .contact-split__social-icon svg {
      width: 23px;
      height: 23px;
    }

  }


  @media (prefers-reduced-motion: reduce) {

    .contact-split button,
    .contact-split__social-link {
      transition: none;
    }

  }

{% endstylesheet %}


{% schema %}
{
  "name": "Contact Form Split",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Contact Gacha Treasures"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Looking for something?"
    },
    {
      "type": "inline_richtext",
      "id": "accent_heading",
      "label": "Accent heading",
      "default": "Tell us about it."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Have a question, need help finding a collectible, or have an idea for a custom print? Send a message and the shop can reply directly by email.</p>"
    },
    {
      "type": "richtext",
      "id": "notice",
      "label": "Notice",
      "default": "<p>Your message goes privately to the shop. We will reply using the email address you provide. No personal phone number is published.</p>"
    },
    {
      "type": "text",

    }
    updatePreview(options = {}) {
      const get = (n, fb) => {
        const i = this.el('[data-case-control="' + n + '"]');
        return i ? Number(i.value) : fb;
      };
      const scale = get('scale', 100),
        x = get('x', 0),
        y = get('y', 0),
        rotation = get('rotation', 0);
      const effect = (name) => {
        const input = this.el('[data-case-effect="' + name + '"]');
        return input ? Number(input.value) : 100;
      };
      const brightness = effect('brightness');
      const contrast = effect('contrast');
      const saturation = effect('saturation');
      this.els('[data-case-output]').forEach((out) => {
        const inp = this.el('[data-case-control="' + out.dataset.caseOutput + '"]');
        if (!inp) return;
        out.textContent =
          out.dataset.caseOutput === 'scale'
            ? inp.value + '%'
            : out.dataset.caseOutput === 'rotation'
            ? inp.value + 'deg'
            : inp.value;
      });
      if (this.art) {
        this.art.style.setProperty('--art-scale', scale / 100);
        this.art.style.setProperty('--art-x', x + '%');
        this.art.style.setProperty('--art-y', y + '%');
        this.art.style.setProperty('--art-rotation', rotation + 'deg');
        this.art.style.setProperty('--art-flip-x', this.flipX);
        this.art.style.setProperty('--art-flip-y', this.flipY);
        this.art.style.setProperty('--art-brightness', brightness / 100);
        this.art.style.setProperty('--art-contrast', contrast / 100);
        this.art.style.setProperty('--art-saturation', saturation / 100);
        if (this.art.tagName !== 'IMG') {
          const fitProperty = this.editorProperty('fit');
          this.art.style.backgroundSize = fitProperty && fitProperty.value === 'Fit image' ? 'contain' : 'cover';
          this.art.style.backgroundRepeat = 'no-repeat';
          this.art.style.backgroundPosition = 'center';
        }
      }
      this.els('[data-case-toolbar-output]').forEach((output) => {
        const name = output.dataset.caseToolbarOutput;
        const control = this.el('[data-case-control="' + name + '"]') || this.el('[data-case-effect="' + name + '"]');
        if (!control) return;
        output.textContent = control.value + (name === 'rotation' ? 'deg' : '%');
      });
      this.setEditorProperty('brightness', brightness + '%');
      this.setEditorProperty('contrast', contrast + '%');
      this.setEditorProperty('saturation', saturation + '%');
      this.updateEditorButtons();
      if (this.canvasEditor && !options.skipCanvas) {
        this.canvasEditor.applyState({
          scale,
          x,
          y,
          rotation,
          flipX: this.flipX,
          flipY: this.flipY,
          brightness,
          contrast,
          saturation,
        });
      }
    }
    bindQuantity() {
      this.els('.case-quantity').forEach((q) => {
        const inp = q.querySelector('input'),
          minus = q.querySelector('[name="minus"]'),
          plus = q.querySelector('[name="plus"]');
        if (!inp || !minus || !plus) return;
        minus.addEventListener('click', () => {
          inp.value = Math.max(Number(inp.min || 1), Number(inp.value || 1) - 1);
        });
        plus.addEventListener('click', () => {
          inp.value = Number(inp.value || 1) + 1;
        });
      });
    }
    bindViewToggle() {
      this.els('[data-case-view]').forEach((btn) => {
        btn.addEventListener('click', () => {
          this.els('[data-case-view]').forEach((b) => b.classList.toggle('is-active', b === btn));
        });
      });
    }
    bindReset() {
      const reset = this.el('[data-case-reset]');
      if (reset) {
        reset.addEventListener('click', () => {
          this.els('[data-case-control]').forEach((inp) => {
            inp.value = inp.defaultValue;
            this.syncToolbarControl(inp.dataset.caseControl);
          });
          this.els('[data-case-effect]').forEach((inp) => {
            inp.value = inp.defaultValue;
          });
          this.flipX = 1;
          this.flipY = 1;
          this.setArtworkFit('cover');
          this.setLocked(false);
          this.updatePreview();
        });
      }
    }
    bindFormSubmit() {
      if (!this.form) return;
      this.form.addEventListener('submit', (e) => {
        if (!this.art || this.art.hidden) {
          e.preventDefault();
          e.stopPropagation();
          alert('Please add artwork before adding this case to your bag.');
          return;
        }
        if (this.hasCustomFile) {
          this.setLoading(true);
          return;
        }
        e.preventDefault();
        e.stopPropagation();
        this.ajaxAddToCart();
      });
    }
    async ajaxAddToCart() {
      this.setLoading(true);
      const formData = new FormData(this.form);
      formData.delete('properties[Custom artwork]');
      try {
        const res = await fetch(window.Shopify.routes.root + 'cart/add.js', { method: 'POST', body: formData });
        const data = await res.json();
        if (res.ok) {
          const cartRes = await fetch(window.Shopify.routes.root + 'cart.js');
          const cart = await cartRes.json();
          document.querySelectorAll('.cart-count-bubble span,[data-cart-count]').forEach((el) => {
            el.textContent = cart.item_count;
          });
          if (this.submitText) {
            const original = this.submitText.textContent;
            this.submitText.textContent = '\u2713 Added to bag';
            setTimeout(() => {
              this.submitText.textContent = original;
            }, 2000);
          }
        } else {
          alert(data.description || 'Could not add to cart. Please try again.');
        }
      } catch (err) {
        alert('Something went wrong. Please try again.');
      }
      this.setLoading(false);
    }
    setLoading(on) {
      if (this.submit) this.submit.disabled = on;
      if (this.submitText) this.submitText.classList.toggle('hidden', on);
      if (this.submitLoading) this.submitLoading.classList.toggle('hidden', !on);
    }
    destroy() {
      this.canvasEditor?.destroy();
      if (this.objectUrl) URL.revokeObjectURL(this.objectUrl);
    }
  }
  function initCaseBuilders(container) {
    container = container || document;
    container.querySelectorAll('[data-case-builder]').forEach((root) => {
      if (root.dataset.caseBuilderInit) return;
      root.dataset.caseBuilderInit = 'true';
      root.caseBuilder = new CaseBuilder(root);
    });
  }
  initCaseBuilders();
  document.addEventListener('shopify:section:load', function (e) {
    initCaseBuilders(e.target);
  });
  document.addEventListener('shopify:section:unload', function (e) {
    e.target.querySelectorAll('[data-case-builder]').forEach((root) => root.caseBuilder?.destroy());
  });

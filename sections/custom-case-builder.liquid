      const containedScale = Math.min(shellWidth / image.naturalWidth, shellHeight / image.naturalHeight);
      const renderedWidth = image.naturalWidth * containedScale;
      const renderedHeight = image.naturalHeight * containedScale;
      const offsetX = (shellWidth - renderedWidth) / 2;

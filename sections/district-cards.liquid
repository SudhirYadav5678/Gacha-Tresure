{% style %}
  #shopify-section-{{ section.id }} .district-cards {
    --district-bg: {{ section.settings.background }};
    --district-text: {{ section.settings.text_color }};
    --district-accent: {{ section.settings.accent_color }};
    --district-gap: {{ section.settings.gap }}px;
    --district-radius: {{ section.settings.card_radius }}px;
    --district-height: {{ section.settings.card_height }}px;
    --district-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .lux-page-width {
    width: min(var(--page-width, 1360px), calc(100vw - 48px));
    margin-inline: auto;
  }
  #shopify-section-{{ section.id }} .lux-placeholder {
    width: 100%;
    height: 100%;
    min-height: 220px;
    display: grid;
    place-items: center;
    color: rgba(255,255,255,.72);
    background: radial-gradient(circle at 70% 20%, rgba(231,162,188,.28), transparent 28%), linear-gradient(135deg, #4b1735, #170913 68%);
  }
  #shopify-section-{{ section.id }} .lux-placeholder svg {
    width: min(220px, 56%);
    opacity: .35;
  }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .lux-page-width {
      width: min(100% - 36px, var(--page-width, 1360px));
    }
  }
{% endstyle %}

<section class="district-cards">
  <div class="district-cards__inner lux-page-width">
    {% for block in section.blocks %}
      {% liquid
        assign collection = block.settings.collection
        assign title = block.settings.title | default: collection.title
        assign link = block.settings.custom_link | default: collection.url
        assign image = block.settings.image | default: collection.featured_image
        assign mobile_image = block.settings.mobile_image | default: image
      %}
      <article class="district-card" {{ block.shopify_attributes }}>
        {% if link != blank %}<a class="district-card__link" href="{{ link }}" aria-label="{{ title | escape }}">{% endif %}
          <div class="district-card__media">
            {% if image != blank %}
              <picture>
                {% if mobile_image != blank %}
                  <source media="(max-width: 767px)" srcset="{{ mobile_image | image_url: width: 720 }}">
                {% endif %}
                {{ image | image_url: width: 1200 | image_tag: widths: '500, 720, 900, 1200', sizes: '(max-width: 767px) 90vw, 45vw', loading: 'lazy', class: 'district-card__image' }}
              </picture>
            {% else %}
              <div class="lux-placeholder">{{ 'collection-1' | placeholder_svg_tag }}</div>
            {% endif %}
          </div>
          <div class="district-card__content">
            {% if block.settings.eyebrow != blank %}
              <span>{{ block.settings.eyebrow }}</span>
            {% endif %}
            <h2>{{ title }}</h2>
            {% if block.settings.description != blank %}
              <p>{{ block.settings.description }}</p>
            {% endif %}
            {% if block.settings.button_label != blank %}
              <em>{{ block.settings.button_label }}</em>
            {% endif %}
          </div>
        {% if link != blank %}</a>{% endif %}
      </article>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .district-cards {
    position: relative;
    color: var(--district-text);
    background: var(--district-bg);
    margin-top: -72px;
    z-index: 3;
  }
  .district-cards__inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--district-gap);
  }
  .district-card {
    min-height: var(--district-height);
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.14);
    border-radius: var(--district-radius);
    background: #2d0a20;
  }
  .district-card__link {
    display: grid;
    min-height: inherit;
    color: inherit;
    text-decoration: none;
  }
  .district-card__media,
  .district-card__media picture {
    position: absolute;
    inset: 0;
  }
  .district-card__image,
  .district-card__media .lux-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s ease;
  }
  .district-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(23,9,19,.08), rgba(23,9,19,var(--district-overlay)) 72%);
    pointer-events: none;
  }
  .district-card__content {
    position: relative;
    z-index: 2;
    align-self: end;
    padding: clamp(22px, 4vw, 42px);
  }
  .district-card__content span {
    color: var(--district-accent);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .district-card__content h2 {
    margin: 9px 0 8px;
    font-family: var(--font-heading-family);
    font-size: clamp(28px, 3.3vw, 46px);
    font-weight: 500;
    line-height: 1;
  }
  .district-card__content p {
    max-width: 420px;
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    opacity: .84;
  }
  .district-card__content em {
    display: inline-block;
    margin-top: 18px;
    color: var(--district-accent);
    font-style: normal;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .district-card:hover .district-card__image { transform: scale(1.05); }
  .district-card__link:focus-visible {
    outline: 3px solid var(--district-accent);
    outline-offset: -6px;
  }
  @media (max-width: 767px) {
    .district-cards {
      margin-top: 0;
      padding-top: 18px !important;
    }
    .district-cards__inner { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "District cards",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#170913" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFF9F2" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#F0AFCA" },
    { "type": "range", "id": "gap", "label": "Card gap", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 8, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "card_height", "label": "Card height", "min": 260, "max": 520, "step": 20, "unit": "px", "default": 340 },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 30, "max": 95, "step": 5, "unit": "%", "default": 70 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "district",
      "name": "District",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "A curated gate into collectible pieces, giftable surprises, and display-ready finds." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore" },
        { "type": "url", "id": "custom_link", "label": "Custom link" }
      ]
    }
  ],
  "presets": [
    { "name": "District cards" }
  ]
}
{% endschema %}

{% style %}
  #shopify-section-{{ section.id }} .category-grid {
    --cat-bg: {{ section.settings.background }};
    --cat-text: {{ section.settings.text_color }};
    --cat-accent: {{ section.settings.accent_color }};
    --cat-card-text: {{ section.settings.card_text_color }};
    --cat-gap: {{ section.settings.gap }}px;
    --cat-radius: {{ section.settings.card_radius }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .lux-page-width {
    width: min(var(--page-width, 1360px), calc(100vw - 48px));
    margin-inline: auto;
  }
  #shopify-section-{{ section.id }} .lux-placeholder {
    width: 100%;
    height: 100%;
    min-height: 220px;
    display: grid;
    place-items: center;
    color: rgba(255,255,255,.72);
    background: radial-gradient(circle at 70% 20%, rgba(231,162,188,.28), transparent 28%), linear-gradient(135deg, #4b1735, #170913 68%);
  }
  #shopify-section-{{ section.id }} .lux-placeholder svg {
    width: min(220px, 56%);
    opacity: .35;
  }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .lux-page-width {
      width: min(100% - 36px, var(--page-width, 1360px));
    }
  }
{% endstyle %}

<section class="category-grid">
  <div class="category-grid__inner lux-page-width">
    <div class="category-grid__header">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="category-grid__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.body != blank %}
        <div class="category-grid__body">{{ section.settings.body }}</div>
      {% endif %}
    </div>
    <div class="category-grid__cards category-grid__cards--mobile-{{ section.settings.mobile_layout }}">
      {% for block in section.blocks %}
        {% liquid
          assign collection = block.settings.collection
          assign title = block.settings.title | default: collection.title
          assign link = block.settings.link | default: collection.url
          assign image = block.settings.image | default: collection.featured_image
        %}
        <article class="category-card category-card--{{ block.settings.size }} category-card--text-{{ block.settings.text_position }}" {{ block.shopify_attributes }}>
          {% if link != blank %}<a href="{{ link }}" class="category-card__link" aria-label="{{ title | escape }}">{% endif %}
            <div class="category-card__media">
              {% if image != blank %}
                {{ image | image_url: width: 1300 | image_tag: widths: '400, 650, 900, 1300', sizes: '(max-width: 767px) 92vw, 33vw', loading: 'lazy', class: 'category-card__image' }}
              {% else %}
                <div class="lux-placeholder">{{ 'collection-2' | placeholder_svg_tag }}</div>
              {% endif %}
            </div>
            <div class="category-card__content">
              <h3>{{ title }}</h3>
              {% if block.settings.subtitle != blank %}
                <p>{{ block.settings.subtitle }}</p>
              {% endif %}
            </div>
          {% if link != blank %}</a>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .category-grid {
    color: var(--cat-text);
    background: var(--cat-bg);
  }
  .category-grid__header {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(260px, .75fr);
    gap: clamp(24px, 8vw, 120px);
    align-items: end;
    margin-bottom: clamp(34px, 5vw, 70px);
  }
  .category-grid__eyebrow {
    margin: 0 0 14px;
    color: var(--cat-accent);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .category-grid h2 {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(44px, 6.4vw, 92px);
    font-weight: 500;
    line-height: .96;
    white-space: pre-line;
  }
  .category-grid h2 em {
    color: var(--cat-accent);
    font-style: italic;
  }
  .category-grid__body {
    font-size: 15px;
    line-height: 1.7;
    opacity: .72;
  }
  .category-grid__body p { margin: 0; }
  .category-grid__cards {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: minmax(210px, 16vw);
    gap: var(--cat-gap);
  }
  .category-card {
    position: relative;
    overflow: hidden;
    border-radius: var(--cat-radius);
    background: var(--lux-wine);
    color: var(--cat-card-text);
  }
  .category-card--small,
  .category-card--medium { grid-column: span 2; }
  .category-card--wide { grid-column: span 3; }
  .category-card--large {
    grid-column: span 6;
    min-height: 360px;
  }
  .category-card__link {
    display: grid;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  .category-card__media,
  .category-card__image,
  .category-card__media .lux-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .category-card__image {
    object-fit: cover;
    transition: transform .6s ease;
  }
  .category-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(23,9,19,.04), rgba(23,9,19,.74));
  }
  .category-card__content {
    position: relative;
    z-index: 2;
    align-self: end;
    padding: clamp(18px, 3vw, 34px);
  }
  .category-card--text-top .category-card__content { align-self: start; }
  .category-card--text-center .category-card__content { align-self: center; }
  .category-card h3 {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(24px, 2.4vw, 38px);
    font-weight: 500;
  }
  .category-card p {
    margin: 7px 0 0;
    font-size: 13px;
    line-height: 1.5;
    opacity: .82;
  }
  .category-card:hover .category-card__image { transform: scale(1.055); }
  .category-card__link:focus-visible {
    outline: 3px solid var(--cat-accent);
    outline-offset: -6px;
  }
  @media (max-width: 1024px) {
    .category-grid__cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .category-card,
    .category-card--small,
    .category-card--medium,
    .category-card--wide,
    .category-card--large {
      grid-column: span 1;
      min-height: 270px;
    }
    .category-card--large { grid-column: span 2; }
  }
  @media (max-width: 767px) {
    .category-grid__header { grid-template-columns: 1fr; }
    .category-grid__cards--mobile-stack { grid-template-columns: 1fr; }
    .category-grid__cards--mobile-compact { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .category-card--large { grid-column: span 1; }
    .category-card { min-height: 240px; }
    .category-grid__cards--mobile-compact .category-card { min-height: 180px; }
    .category-grid__cards--mobile-compact .category-card__content { padding: 16px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial category grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New gates in the collection" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Seven doors. <em>Endless discoveries.</em>" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Each door opens into something display-worthy, giftable, or personal. Choose a category and let the next find reveal itself.</p>" },
    { "type": "color", "id": "background", "label": "Background", "default": "#F8F1E8" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#23151E" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#C65E8A" },
    { "type": "color", "id": "card_text_color", "label": "Card text color", "default": "#FFF9F2" },
    { "type": "select", "id": "mobile_layout", "label": "Mobile layout", "default": "stack", "options": [
      { "value": "stack", "label": "Stack" },
      { "value": "compact", "label": "Two columns" }
    ] },
    { "type": "range", "id": "gap", "label": "Card gap", "min": 4, "max": 28, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 8, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 32, "max": 160, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 32, "max": 160, "step": 4, "unit": "px", "default": 112 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Collectible finds for gifting and display." },
        { "type": "url", "id": "link", "label": "Custom link" },
        { "type": "select", "id": "size", "label": "Card size", "default": "medium", "options": [
          { "value": "small", "label": "Small" },
          { "value": "medium", "label": "Medium" },
          { "value": "wide", "label": "Wide" },
          { "value": "large", "label": "Large" }
        ] },
        { "type": "select", "id": "text_position", "label": "Text position", "default": "bottom", "options": [
          { "value": "top", "label": "Top" },
          { "value": "center", "label": "Center" },
          { "value": "bottom", "label": "Bottom" }
        ] }
      ]
    }
  ],
  "presets": [
    { "name": "Editorial category grid" }
  ]
}
{% endschema %}

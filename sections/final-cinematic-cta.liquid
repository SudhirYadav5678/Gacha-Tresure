{% liquid
  assign image = section.settings.image
  assign mobile_image = section.settings.mobile_image | default: image
%}

{% style %}
  #shopify-section-{{ section.id }} .final-cta {
    --final-text: {{ section.settings.text_color }};
    --final-accent: {{ section.settings.accent_color }};
    --final-overlay: {{ section.settings.overlay_color }};
    --final-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --final-min-height: {{ section.settings.min_height }}px;
    --final-position: {{ section.settings.background_position }};
  }
  #shopify-section-{{ section.id }} .lux-page-width {
    width: min(var(--page-width, 1360px), calc(100vw - 48px));
    margin-inline: auto;
  }
  #shopify-section-{{ section.id }} .lux-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 22px;
    border: 1px solid currentColor;
    border-radius: 0;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: .04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform .2s ease, background-color .2s ease, color .2s ease, border-color .2s ease;
  }
  #shopify-section-{{ section.id }} .lux-button:hover { transform: translateY(-1px); }
  #shopify-section-{{ section.id }} .lux-button:focus-visible {
    outline: 2px solid var(--final-accent);
    outline-offset: 3px;
  }
  #shopify-section-{{ section.id }} .lux-button--light {
    color: #170913;
    background: #fff9f2;
    border-color: #fff9f2;
  }
  #shopify-section-{{ section.id }} .lux-button--outline {
    color: inherit;
    background: transparent;
  }
  #shopify-section-{{ section.id }} .lux-placeholder {
    width: 100%;
    height: 100%;
    min-height: 220px;
    display: grid;
    place-items: center;
    color: rgba(255,255,255,.72);
    background: radial-gradient(circle at 70% 20%, rgba(231,162,188,.28), transparent 28%), linear-gradient(135deg, #4b1735, #170913 68%);
  }
  #shopify-section-{{ section.id }} .lux-placeholder svg {
    width: min(220px, 56%);
    opacity: .35;
  }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .lux-page-width {
      width: min(100% - 36px, var(--page-width, 1360px));
    }
    #shopify-section-{{ section.id }} .lux-button {
      width: 100%;
      max-width: 320px;
    }
  }
{% endstyle %}

<section class="final-cta final-cta--{{ section.settings.alignment }}">
  <div class="final-cta__media" aria-hidden="true">
    {% if image != blank %}
      <picture>
        {% if mobile_image != blank %}
          <source media="(max-width: 767px)" srcset="{{ mobile_image | image_url: width: 900 }}">
        {% endif %}
        {{ image | image_url: width: 2200 | image_tag: widths: '750, 1100, 1500, 1900, 2200', sizes: '100vw', loading: 'lazy', class: 'final-cta__image' }}
      </picture>
    {% else %}
      <div class="lux-placeholder">{{ 'lifestyle-2' | placeholder_svg_tag }}</div>
    {% endif %}
  </div>
  <div class="final-cta__shade"></div>
  <div class="final-cta__content lux-page-width">
    {% if section.settings.eyebrow != blank %}
      <p>{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2>
      {{ section.settings.heading }}
      {% if section.settings.accent_heading != blank %}
        <em>{{ section.settings.accent_heading }}</em>
      {% endif %}
    </h2>
    {% if section.settings.body != blank %}
      <div>{{ section.settings.body }}</div>
    {% endif %}
    <div class="final-cta__buttons">
      {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}
        <a class="lux-button lux-button--light" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
      {% endif %}
      {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
        <a class="lux-button lux-button--outline" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .final-cta {
    position: relative;
    min-height: var(--final-min-height);
    display: grid;
    place-items: center;
    overflow: hidden;
    color: var(--final-text);
    background: var(--lux-night);
    text-align: center;
  }
  .final-cta__media,
  .final-cta__shade {
    position: absolute;
    inset: 0;
  }
  .final-cta__image,
  .final-cta__media picture,
  .final-cta__media .lux-placeholder {
    width: 100%;
    height: 100%;
  }
  .final-cta__image {
    object-fit: cover;
    object-position: var(--final-position);
  }
  .final-cta__shade {
    background: var(--final-overlay);
    opacity: var(--final-overlay-opacity);
  }
  .final-cta__content {
    position: relative;
    z-index: 2;
    padding-block: 70px;
  }
  .final-cta--left { text-align: left; }
  .final-cta--right { text-align: right; }
  .final-cta p {
    margin: 0 0 14px;
    color: var(--final-accent);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .final-cta h2 {
    max-width: 880px;
    margin: 0 auto;
    font-family: var(--font-heading-family);
    font-size: clamp(46px, 6vw, 92px);
    font-weight: 500;
    line-height: .98;
  }
  .final-cta--left h2 { margin-left: 0; }
  .final-cta--right h2 { margin-right: 0; }
  .final-cta h2 em {
    display: block;
    color: var(--final-accent);
    font-style: italic;
  }
  .final-cta__content div:not(.final-cta__buttons) {
    max-width: 540px;
    margin: 22px auto 0;
    font-size: 15px;
    line-height: 1.7;
    opacity: .82;
  }
  .final-cta__buttons {
    margin-top: 32px;
    display: flex;
    justify-content: center;
    gap: 13px;
    flex-wrap: wrap;
  }
  .final-cta--left .final-cta__buttons { justify-content: flex-start; }
  .final-cta--right .final-cta__buttons { justify-content: flex-end; }
  @media (max-width: 767px) {
    .final-cta,
    .final-cta--left,
    .final-cta--right { text-align: left; }
    .final-cta h2 { margin-left: 0; }
    .final-cta__content div:not(.final-cta__buttons) { margin-left: 0; }
    .final-cta__buttons { justify-content: flex-start; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Final cinematic CTA",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop background image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile background image" },
    { "type": "select", "id": "background_position", "label": "Background position", "default": "center center", "options": [
      { "value": "center center", "label": "Center" },
      { "value": "center top", "label": "Top" },
      { "value": "center bottom", "label": "Bottom" },
      { "value": "left center", "label": "Left" },
      { "value": "right center", "label": "Right" }
    ] },
    { "type": "select", "id": "alignment", "label": "Text alignment", "default": "center", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Begin the next reveal" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Open the capsule." },
    { "type": "inline_richtext", "id": "accent_heading", "label": "Accent heading", "default": "Keep the story." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Start with one collectible, one case, or one glowing keepsake, then let the collection grow from there.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop new finds" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Build a gift" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#170913" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 25, "max": 95, "step": 5, "unit": "%", "default": 80 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFF9F2" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#F0AFCA" },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 360, "max": 780, "step": 20, "unit": "px", "default": 560 }
  ],
  "presets": [
    { "name": "Final cinematic CTA" }
  ]
}
{% endschema %}

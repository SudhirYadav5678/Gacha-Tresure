{% style %}
  #shopify-section-{{ section.id }} .gacha-announce {
    --ga-bg: {{ section.settings.background }};
    --ga-text: {{ section.settings.text_color }};
    --ga-accent: {{ section.settings.accent_color }};
    --ga-height: {{ section.settings.bar_height }}px;
    --ga-mobile-height: {{ section.settings.mobile_bar_height }}px;
    --ga-size: {{ section.settings.font_size }}px;
    --ga-spacing: {{ section.settings.letter_spacing | divided_by: 100.0 }}em;
    --ga-border: {{ section.settings.divider_color }};
  }
{% endstyle %}

<section class="gacha-announce{% if section.settings.sticky %} gacha-announce--sticky{% endif %}{% if section.settings.uppercase %} gacha-announce--upper{% endif %}{% if section.settings.enable_divider %} gacha-announce--divider{% endif %}" aria-label="Store announcements">
  <div class="gacha-announce__inner">
    {% for block in section.blocks %}
      {% liquid
        assign message_class = 'gacha-announce__message'
        if block.settings.desktop_visibility == 'hide'
          assign message_class = message_class | append: ' gacha-announce__message--desktop-hide'
        endif
        if block.settings.mobile_visibility == 'hide'
          assign message_class = message_class | append: ' gacha-announce__message--mobile-hide'
        endif
      %}
      {% if block.settings.text != blank %}
        <div class="{{ message_class }} gacha-announce__message--{{ forloop.index }}" {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}">
          {% endif %}
          {% if block.settings.icon != blank %}
            <span aria-hidden="true">{{ block.settings.icon }}</span>
          {% endif %}
          <strong>{{ block.settings.text }}</strong>
          {% if block.settings.link != blank %}
            </a>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .gacha-announce {
    position: relative;
    z-index: 40;
    color: var(--ga-text);
    background: var(--ga-bg);
    font-family: var(--font-body-family, Inter, ui-sans-serif, system-ui, sans-serif);
    font-size: var(--ga-size);
    letter-spacing: var(--ga-spacing);
  }

  .gacha-announce--sticky {
    position: sticky;
    top: 0;
  }

  .gacha-announce--divider {
    border-bottom: 1px solid var(--ga-border);
  }

  .gacha-announce--upper {
    text-transform: uppercase;
  }

  .gacha-announce__inner {
    min-height: var(--ga-height);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    width: min(var(--page-width, 1360px), calc(100vw - 48px));
    margin-inline: auto;
  }

  .gacha-announce__message {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    line-height: 1.2;
    white-space: nowrap;
  }

  .gacha-announce__message--2 {
    justify-content: center;
    color: var(--ga-accent);
  }

  .gacha-announce__message--3 {
    justify-content: flex-end;
  }

  .gacha-announce a {
    color: inherit;
    text-decoration: none;
  }

  .gacha-announce a:hover {
    color: var(--ga-accent);
  }

  .gacha-announce a:focus-visible {
    outline: 2px solid var(--ga-accent);
    outline-offset: 3px;
  }

  @media (max-width: 767px) {
    .gacha-announce__inner {
      min-height: var(--ga-mobile-height);
      width: min(100% - 32px, var(--page-width, 1360px));
      display: flex;
      justify-content: center;
      overflow: hidden;
      text-align: center;
    }

    .gacha-announce__message {
      justify-content: center;
      white-space: normal;
    }

    .gacha-announce__message--desktop-hide {
      display: flex;
    }

    .gacha-announce__message--mobile-hide {
      display: none;
    }

    .gacha-announce__message:not(:first-child):not(.gacha-announce__message--desktop-hide) {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .gacha-announce__message--desktop-hide {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gacha announcement bar",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#2B0C21" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#E89AB9" },
    { "type": "color", "id": "divider_color", "label": "Divider color", "default": "#5A2044" },
    { "type": "range", "id": "font_size", "label": "Font size", "min": 10, "max": 14, "step": 1, "unit": "px", "default": 11 },
    { "type": "checkbox", "id": "uppercase", "label": "Uppercase text", "default": true },
    { "type": "range", "id": "letter_spacing", "label": "Letter spacing", "min": 0, "max": 20, "step": 1, "unit": "%", "default": 10 },
    { "type": "range", "id": "bar_height", "label": "Desktop bar height", "min": 28, "max": 56, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "mobile_bar_height", "label": "Mobile bar height", "min": 30, "max": 58, "step": 2, "unit": "px", "default": 38 },
    { "type": "checkbox", "id": "enable_divider", "label": "Show divider", "default": true },
    { "type": "checkbox", "id": "sticky", "label": "Sticky bar", "default": false }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Explore Las Vegas' gacha and armory districts" },
        { "type": "text", "id": "icon", "label": "Optional icon" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "desktop_visibility", "label": "Desktop visibility", "default": "show", "options": [
          { "value": "show", "label": "Show" },
          { "value": "hide", "label": "Hide" }
        ] },
        { "type": "select", "id": "mobile_visibility", "label": "Mobile visibility", "default": "show", "options": [
          { "value": "show", "label": "Show" },
          { "value": "hide", "label": "Hide" }
        ] }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gacha announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Explore Las Vegas' gacha and armory districts", "mobile_visibility": "hide" } },
        { "type": "message", "settings": { "text": "Gacha open now - armory coming soon" } },
        { "type": "message", "settings": { "text": "Capsules - collectibles - custom creations", "mobile_visibility": "hide" } }
      ]
    }
  ]
}
{% endschema %}

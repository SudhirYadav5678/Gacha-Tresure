    #GachaHeader-{{ section.id }} .gacha-header__actions {
      justify-self: end;
      display: inline-flex;
      align-items: center;
      gap: 18px;
      min-height: 64px;
      padding: 0 22px;
      border: 1px solid var(--gh-pill-border);
      border-radius: 999px;
      background: var(--gh-icon-bg);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 14px 40px rgba(0, 0, 0, 0.2);
    }

    #GachaHeader-{{ section.id }} .gacha-header__actions .gacha-header__icon-link {
      width: 30px;
      min-width: 30px;
      height: 44px;
      border: 0;
      border-radius: 0;
      background: transparent;
    }

    #GachaHeader-{{ section.id }} .gacha-header__actions .gacha-header__icon-link svg {
      width: 25px;
      height: 25px;
    }

    #GachaHeader-{{ section.id }} .gacha-header__content h2 {

{% liquid
  assign active_sort = collection.sort_by | default: collection.default_sort_by
%}

{% style %}
  #shopify-section-{{ section.id }} .gacha-toolbar {
    --gt-bg: {{ section.settings.background }};
    --gt-text: {{ section.settings.text_color }};
    --gt-border: {{ section.settings.border_color }};
    --gt-active-bg: {{ section.settings.active_chip_background }};
    --gt-active-text: {{ section.settings.active_chip_text_color }};
    --gt-chip-radius: {{ section.settings.chip_radius }}px;
    --gt-pad: {{ section.settings.toolbar_padding }}px;
    --gt-gap: {{ section.settings.desktop_spacing }}px;
  }
{% endstyle %}

<section class="gacha-toolbar{% if section.settings.sticky_toolbar %} gacha-toolbar--sticky{% endif %}">
  <div class="gacha-toolbar__inner">
    {% if section.settings.show_search %}
      <form class="gacha-toolbar__search" action="{{ routes.search_url }}" method="get" role="search">
        <input type="hidden" name="type" value="product">
        <input type="hidden" name="options[prefix]" value="last">
        <span aria-hidden="true">⌕</span>
        <label class="gacha-toolbar__sr" for="GachaSearch-{{ section.id }}">Search products</label>
        <input id="GachaSearch-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.search_placeholder | escape }}">
        <button type="reset" aria-label="Clear search">×</button>
      </form>
    {% endif %}

    {% if section.settings.show_filters %}
      <nav class="gacha-toolbar__chips" aria-label="Collection filters">
        {% for block in section.blocks %}
          {% liquid
            assign chip_collection = block.settings.collection
            assign chip_url = block.settings.custom_url | default: chip_collection.url
            assign chip_label = block.settings.label | default: chip_collection.title
            assign is_active = false
            if chip_collection != blank and collection.handle == chip_collection.handle
              assign is_active = true
            endif
            if forloop.first and block.settings.active_by_default
              assign is_active = true
            endif
          %}
          {% if chip_label != blank %}
            <a class="gacha-toolbar__chip{% if is_active %} is-active{% endif %}" href="{% if chip_url != blank %}{{ chip_url }}{% else %}{{ collection.url }}{% endif %}" {{ block.shopify_attributes }}>
              {{ chip_label }}
            </a>
          {% endif %}
        {% endfor %}
      </nav>
    {% endif %}

    {% if section.settings.show_sort and collection.sort_options.size > 0 %}
      <form class="gacha-toolbar__sort" method="get" action="{{ collection.url }}">
        <label for="GachaSort-{{ section.id }}">{{ section.settings.sort_label }}</label>
        <select id="GachaSort-{{ section.id }}" name="sort_by" onchange="this.form.submit()">
          {% for option in collection.sort_options %}
            <option value="{{ option.value | escape }}"{% if option.value == active_sort %} selected{% endif %}>{{ option.name }}</option>
          {% endfor %}
        </select>
      </form>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .gacha-toolbar {
    color: var(--gt-text);
    background: var(--gt-bg);
    border-top: 1px solid var(--gt-border);
    border-bottom: 1px solid var(--gt-border);
    font-family: var(--font-body-family, Inter, ui-sans-serif, system-ui, sans-serif);
  }

  .gacha-toolbar--sticky {
    position: sticky;
    top: 0;
    z-index: 25;
  }

  .gacha-toolbar__inner {
    width: min(var(--page-width, 1360px), calc(100vw - 96px));
    min-height: 82px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(220px, .85fr) minmax(0, 1.7fr) minmax(160px, .45fr);
    gap: var(--gt-gap);
    align-items: center;
    padding-block: var(--gt-pad);
  }

  .gacha-toolbar__search {
    height: 44px;
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid var(--gt-border);
  }

  .gacha-toolbar__search input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    color: inherit;
    background: transparent;
    font: inherit;
    font-size: 13px;
  }

  .gacha-toolbar__search span {
    color: var(--gt-text);
    opacity: .62;
  }

  .gacha-toolbar__search button {
    width: 28px;
    height: 28px;
    border: 0;
    color: inherit;
    background: transparent;
    cursor: pointer;
    opacity: .6;
  }

  .gacha-toolbar__chips {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .gacha-toolbar__chip {
    min-height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    padding-inline: 14px;
    color: inherit;
    border: 1px solid var(--gt-border);
    border-radius: var(--gt-chip-radius);
    font-size: 12px;
    font-weight: 750;
    text-decoration: none;
    transition: background-color .2s ease, color .2s ease, border-color .2s ease;
  }

  .gacha-toolbar__chip:hover,
  .gacha-toolbar__chip.is-active {
    color: var(--gt-active-text);
    background: var(--gt-active-bg);
    border-color: var(--gt-active-bg);
  }

  .gacha-toolbar__sort {
    justify-self: end;
    min-width: 170px;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 10px;
    color: inherit;
  }

  .gacha-toolbar__sort label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    opacity: .62;
  }

  .gacha-toolbar__sort select {
    min-height: 42px;
    padding: 0 34px 0 13px;
    color: inherit;
    background: transparent;
    border: 1px solid var(--gt-border);
    font-size: 12px;
    font-weight: 700;
  }

  .gacha-toolbar a:focus-visible,
  .gacha-toolbar button:focus-visible,
  .gacha-toolbar input:focus-visible,
  .gacha-toolbar select:focus-visible {
    outline: 2px solid var(--gt-active-bg);
    outline-offset: 3px;
  }

  .gacha-toolbar__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (max-width: 980px) {
    .gacha-toolbar__inner {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .gacha-toolbar__sort {
      justify-self: stretch;
      grid-template-columns: 72px 1fr;
    }
  }

  @media (max-width: 767px) {
    .gacha-toolbar__inner {
      width: min(100% - 36px, var(--page-width, 1360px));
      min-height: auto;
      padding-block: 18px;
    }

    .gacha-toolbar__chips {
      width: calc(100% + 18px);
      padding-right: 18px;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('.gacha-toolbar__search').forEach((form) => {
    const input = form.querySelector('input[type="search"]');
    const clear = form.querySelector('button[type="reset"]');
    if (!input || !clear) return;
    clear.addEventListener('click', () => {
      window.requestAnimationFrame(() => input.focus());
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "Gacha collection toolbar",
  "settings": [
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "checkbox", "id": "show_filters", "label": "Show filter chips", "default": true },
    { "type": "checkbox", "id": "show_sort", "label": "Show sort", "default": true },
    { "type": "checkbox", "id": "sticky_toolbar", "label": "Sticky toolbar", "default": false },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search the district" },
    { "type": "text", "id": "sort_label", "label": "Sort label", "default": "Sort" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FBF6EE" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#281920" },
    { "type": "color", "id": "border_color", "label": "Border color", "default": "#DDD1C6" },
    { "type": "color", "id": "active_chip_background", "label": "Active chip background", "default": "#2B0C21" },
    { "type": "color", "id": "active_chip_text_color", "label": "Active chip text", "default": "#FFFFFF" },
    { "type": "range", "id": "chip_radius", "label": "Chip radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "toolbar_padding", "label": "Toolbar vertical padding", "min": 8, "max": 32, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "desktop_spacing", "label": "Desktop spacing", "min": 12, "max": 40, "step": 2, "unit": "px", "default": 22 }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Filter chip",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "All finds" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "custom_url", "label": "Custom URL" },
        { "type": "checkbox", "id": "active_by_default", "label": "Active by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gacha collection toolbar",
      "blocks": [
        { "type": "chip", "settings": { "label": "All finds", "active_by_default": true } },
        { "type": "chip", "settings": { "label": "Gachapon" } },
        { "type": "chip", "settings": { "label": "Blind boxes" } },
        { "type": "chip", "settings": { "label": "Figures and model kits" } },
        { "type": "chip", "settings": { "label": "Plushies" } },
        { "type": "chip", "settings": { "label": "Keychains and earrings" } },
        { "type": "chip", "settings": { "label": "DIY miniature kits" } },
        { "type": "chip", "settings": { "label": "3D prints" } }
      ]
    }
  ]
}
{% endschema %}

{% liquid
  assign hero_image = section.settings.image
  assign mobile_image = section.settings.mobile_image | default: hero_image
%}

{% style %}
  #shopify-section-{{ section.id }} .gacha-hero {
    --gh-text-bg: {{ section.settings.text_background }};
    --gh-text: {{ section.settings.text_color }};
    --gh-accent: {{ section.settings.accent_color }};
    --gh-image-width: {{ section.settings.image_width }}%;
    --gh-gradient: {{ section.settings.gradient_strength | divided_by: 100.0 }};
    --gh-min: {{ section.settings.desktop_min_height }}px;
    --gh-mobile-min: {{ section.settings.mobile_min_height }}px;
    --gh-content-width: {{ section.settings.content_width }}px;
    --gh-align: {{ section.settings.content_alignment }};
    --gh-heading-desktop: {{ section.settings.heading_size_desktop }}px;
    --gh-heading-tablet: {{ section.settings.heading_size_tablet }}px;
    --gh-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --gh-body-size: {{ section.settings.body_size }}px;
    --gh-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --gh-line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    --gh-focal: {{ section.settings.image_position }};
  }
{% endstyle %}

<section class="gacha-hero gacha-hero--mobile-{{ section.settings.mobile_order }}">
  <div class="gacha-hero__copy">
    <div class="gacha-hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="gacha-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h1>
        <span>{{ section.settings.heading }}</span>
        {% if section.settings.accent_heading != blank %}
          <em>{{ section.settings.accent_heading }}</em>
        {% endif %}
      </h1>
      {% if section.settings.body != blank %}
        <div class="gacha-hero__body">{{ section.settings.body }}</div>
      {% endif %}
      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a class="gacha-hero__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>
  <div class="gacha-hero__media">
    {% if hero_image != blank %}
      <picture>
        {% if mobile_image != blank %}
          <source media="(max-width: 767px)" srcset="{{ mobile_image | image_url: width: 900 }}">
        {% endif %}
        {{ hero_image | image_url: width: 2000 | image_tag: widths: '720, 1000, 1400, 1700, 2000', sizes: '(max-width: 767px) 100vw, 58vw', loading: 'eager', class: 'gacha-hero__image' }}
      </picture>
    {% else %}
      <div class="gacha-hero__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
    {% endif %}
    {% if section.settings.badge_text != blank %}
      <span class="gacha-hero__badge">{{ section.settings.badge_text }}</span>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .gacha-hero {
    min-height: var(--gh-min);
    display: grid;
    grid-template-columns: minmax(0, calc(100% - var(--gh-image-width))) minmax(0, var(--gh-image-width));
    overflow: hidden;
    color: var(--gh-text);
    background: var(--gh-text-bg);
    font-family: var(--font-body-family, Inter, ui-sans-serif, system-ui, sans-serif);
  }

  .gacha-hero__copy {
    position: relative;
    z-index: 2;
    min-height: var(--gh-min);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(56px, 8vw, 124px) clamp(24px, 6vw, 96px);
    background: var(--gh-text-bg);
  }

  /* Critical Fix: Updated gradient overlay to match image_4b5e4c.jpg */
  .gacha-hero__copy::after {
    content: "";
    position: absolute;
    top: 0;
    /* Extend the gradient far enough into the image area */
    right: -400px; 
    bottom: 0;
    /* Ensure the gradient element is wide enough */
    width: 400px;
    background: linear-gradient(90deg, var(--gh-text-bg) 0%, var(--gh-text-bg) 10%, rgba(43,12,33,0) 100%);
    opacity: var(--gh-gradient);
    pointer-events: none;
    z-index: 3;
  }

  .gacha-hero__content {
    width: min(100%, var(--gh-content-width));
    text-align: var(--gh-align);
  }

  .gacha-hero__eyebrow {
    margin: 0 0 18px;
    color: var(--gh-accent);
    font-size: var(--gh-eyebrow-size);
    font-weight: 850;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .gacha-hero h1 {
    margin: 0;
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(var(--gh-heading-mobile), 6vw, var(--gh-heading-desktop));
    line-height: var(--gh-line-height);
    font-weight: 500;
  }

  .gacha-hero h1 span,
  .gacha-hero h1 em {
    display: block;
  }

  .gacha-hero h1 em {
    color: var(--gh-accent);
    font-style: italic;
  }

  .gacha-hero__body {
    max-width: 620px;
    margin-top: 26px;
    font-size: var(--gh-body-size);
    line-height: 1.7;
    opacity: .82;
  }

  .gacha-hero__body p {
    margin: 0;
  }

  .gacha-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin-top: 32px;
    padding-inline: 24px;
    color: #281920;
    background: var(--gh-accent);
    border: 1px solid var(--gh-accent);
    font-size: 12px;
    font-weight: 850;
    letter-spacing: .06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform .2s ease, filter .2s ease;
  }

  .gacha-hero__button:hover {
    transform: translateY(-1px);
    filter: brightness(1.04);
  }

  .gacha-hero__button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .gacha-hero__media {
    position: relative;
    min-height: var(--gh-min);
    overflow: hidden;
    background: #1b1422;
  }

  .gacha-hero__media picture,
  .gacha-hero__image,
  .gacha-hero__placeholder {
    width: 100%;
    height: 100%;
  }

  .gacha-hero__image {
    object-fit: cover;
    object-position: var(--gh-focal);
  }

  .gacha-hero__placeholder {
    min-height: inherit;
    display: grid;
    place-items: center;
    color: rgba(255,255,255,.68);
    background: radial-gradient(circle at 68% 22%, rgba(232,154,185,.22), transparent 26%), linear-gradient(135deg, #4a1737, #11080f 74%);
  }

  .gacha-hero__placeholder svg {
    width: min(280px, 50%);
    opacity: .36;
  }

  .gacha-hero__badge {
    position: absolute;
    right: 26px;
    bottom: 26px;
    padding: 11px 14px;
    color: #fff;
    background: rgba(43,12,33,.78);
    border: 1px solid rgba(255,255,255,.18);
    font-size: 11px;
    font-weight: 850;
    letter-spacing: .08em;
    text-transform: uppercase;
    z-index: 4;
  }

  @media (max-width: 1023px) {
    .gacha-hero h1 {
      font-size: clamp(var(--gh-heading-mobile), 7vw, var(--gh-heading-tablet));
    }
  }

  @media (max-width: 767px) {
    .gacha-hero {
      min-height: auto;
      grid-template-columns: 1fr;
    }

    .gacha-hero--mobile-image_first .gacha-hero__copy {
      order: 2;
    }

    .gacha-hero__copy {
      min-height: var(--gh-mobile-min);
      padding: 56px 20px;
    }

    .gacha-hero__copy::after {
      display: none;
    }

    .gacha-hero__content {
      text-align: left;
    }

    .gacha-hero__media {
      min-height: 360px;
    }

    .gacha-hero__button {
      width: 100%;
      max-width: 320px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gacha-hero__button {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gacha district hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Gacha district - now open" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "The thrill is" },
    { "type": "inline_richtext", "id": "accent_heading", "label": "Accent heading", "default": "in the find." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Capsule surprises, blind-box drops, tiny worlds, custom cases, and memories shaped through 3D printing for collectors who still love discovery.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "badge_text", "label": "Image badge", "default": "Curated in Las Vegas" },
    { "type": "color", "id": "text_background", "label": "Text background", "default": "#2B0C21" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FBF6EE" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#E89AB9" },
    { "type": "select", "id": "content_alignment", "label": "Text alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "select", "id": "image_position", "label": "Image focal point", "default": "center center", "options": [
      { "value": "center center", "label": "Center" },
      { "value": "center top", "label": "Top" },
      { "value": "center bottom", "label": "Bottom" },
      { "value": "left center", "label": "Left" },
      { "value": "right center", "label": "Right" }
    ] },
    { "type": "select", "id": "mobile_order", "label": "Mobile order", "default": "text_first", "options": [
      { "value": "text_first", "label": "Text first" },
      { "value": "image_first", "label": "Image first" }
    ] },
    { "type": "range", "id": "image_width", "label": "Desktop image width", "min": 45, "max": 65, "step": 5, "unit": "%", "default": 60 },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 360, "max": 760, "step": 20, "unit": "px", "default": 620 },
    { "type": "range", "id": "gradient_strength", "label": "Gradient strength", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "desktop_min_height", "label": "Desktop minimum height", "min": 520, "max": 860, "step": 20, "unit": "px", "default": 720 },
    { "type": "range", "id": "mobile_min_height", "label": "Mobile text minimum height", "min": 320, "max": 620, "step": 20, "unit": "px", "default": 420 },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size desktop", "min": 54, "max": 112, "step": 2, "unit": "px", "default": 90 },
    { "type": "range", "id": "heading_size_tablet", "label": "Heading size tablet", "min": 44, "max": 86, "step": 2, "unit": "px", "default": 70 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size mobile", "min": 40, "max": 62, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "heading_line_height", "label": "Heading line height", "min": 84, "max": 110, "step": 2, "unit": "%", "default": 92 },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 10, "max": 14, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "body_size", "label": "Body size", "min": 13, "max": 18, "step": 1, "unit": "px", "default": 15 }
  ],
  "presets": [
    { "name": "Gacha district hero" }
  ]
}
{% endschema %}
{% comment %}
  Filename: how-it-works-steps.liquid
  Description: A responsive, 3-column steps section with a boxed layout, featuring a distinct header and vertical dividers between steps on desktop.
{% endcomment %}

<style>
  /* --- Variables & Section Setup --- */
  #shopify-section-{{ section.id }} {
    --outer-bg: {{ section.settings.outer_bg_color }};
    --inner-bg: {{ section.settings.inner_bg_color }};
    --text-color: {{ section.settings.text_color }};
    --divider-color: {{ section.settings.divider_color }};
    
    --pt-desktop: {{ section.settings.padding_top }}px;
    --pb-desktop: {{ section.settings.padding_bottom }}px;
    --pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    
    --inner-p-desktop: {{ section.settings.inner_padding_desktop }}px;
    --inner-p-mobile: {{ section.settings.inner_padding_mobile }}px;

    background-color: var(--outer-bg);
    padding-top: var(--pt-mobile);
    padding-bottom: var(--pb-mobile);
  }

  @media screen and (min-width: 1025px) {
    #shopify-section-{{ section.id }} {
      padding-top: var(--pt-desktop);
      padding-bottom: var(--pb-desktop);
    }
  }

  /* --- Container & Boxed Layout --- */
  .hws-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
  }

  .hws-container {
    background-color: var(--inner-bg);
    color: var(--text-color);
    padding: var(--inner-p-mobile);
    border-radius: {{ section.settings.border_radius }}px;
    {% if section.settings.is_boxed == false %}
      background-color: transparent;
      padding-left: 0;
      padding-right: 0;
    {% endif %}
  }

  @media screen and (min-width: 1025px) {
    .hws-container {
      padding: var(--inner-p-desktop);
    }
  }

  /* --- Header Area --- */
  .hws-header {
    margin-bottom: 48px;
    text-align: {{ section.settings.content_alignment }};
  }

  @media screen and (min-width: 768px) {
    .hws-header {
      margin-bottom: 72px;
    }
  }

  .hws-eyebrow {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 16px;
    display: block;
    font-family: var(--font-body-family), sans-serif;
  }

  .hws-heading {
    margin: 0;
    font-family: var(--font-heading-family), serif;
    font-size: {{ section.settings.heading_size_mobile }}px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--text-color);
  }

  @media screen and (min-width: 768px) {
    .hws-heading {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }
  }

  /* --- Grid & Steps --- */
  .hws-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  @media screen and (min-width: 768px) {
    .hws-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
  }

  @media screen and (min-width: 1025px) {
    .hws-grid {
      gap: 0; /* Gap is handled by padding and borders on desktop */
    }
  }

  .hws-step {
    display: flex;
    flex-direction: column;
    text-align: {{ section.settings.content_alignment }};
  }

  /* Desktop Vertical Dividers */
  @media screen and (min-width: 1025px) {
    .hws-step:not(:first-child) {
      border-left: 1px solid var(--divider-color);
      padding-left: 48px;
    }
    .hws-step:not(:last-child) {
      padding-right: 48px;
    }
  }

  .hws-step-number {
    font-size: 0.65rem;
    font-weight: 400;
    opacity: 0.7;
    margin-bottom: 24px;
    font-family: var(--font-body-family), sans-serif;
  }

  .hws-step-title {
    font-family: var(--font-heading-family), serif;
    font-size: 1.25rem;
    font-weight: 400;
    margin: 0 0 12px 0;
    line-height: 1.3;
    color: var(--text-color);
  }

  .hws-step-desc {
    font-size: 0.75rem;
    line-height: 1.5;
    opacity: 0.8;
    margin: 0;
    font-family: var(--font-body-family), sans-serif;
    max-width: 90%;
  }
  
  {% if section.settings.content_alignment == 'center' %}
    .hws-step-desc { margin: 0 auto; }
  {% elsif section.settings.content_alignment == 'right' %}
    .hws-step-desc { margin: 0 0 0 auto; }
  {% endif %}

</style>

<div class="hws-wrapper">
  <div class="hws-container">
    
    <div class="hws-header">
      {% if section.settings.eyebrow != blank %}
        <span class="hws-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="hws-heading">{{ section.settings.heading }}</h2>
      {% endif %}
    </div>

    <div class="hws-grid">
      {% for block in section.blocks %}
        <div class="hws-step" {{ block.shopify_attributes }}>
          {% if block.settings.number != blank %}
            <div class="hws-step-number">{{ block.settings.number }}</div>
          {% endif %}
          
          {% if block.settings.title != blank %}
            <h3 class="hws-step-title">{{ block.settings.title }}</h3>
          {% endif %}
          
          {% if block.settings.description != blank %}
            <p class="hws-step-desc">{{ block.settings.description }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "How It Works (Steps)",
  "settings": [
    {
      "type": "header",
      "content": "Text Settings"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "HOW THE PULL WORKS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three steps. One surprise."
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Typography Settings"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Heading Size (Desktop)",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Heading Size (Mobile)",
      "default": 32
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "outer_bg_color",
      "label": "Outer Background Color",
      "default": "#F9F6F0"
    },
    {
      "type": "color",
      "id": "inner_bg_color",
      "label": "Inner Box Background Color",
      "default": "#2D182A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider Color",
      "default": "rgba(255,255,255,0.15)"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "checkbox",
      "id": "is_boxed",
      "label": "Use Boxed Layout",
      "default": true
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Maximum Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Inner Box Border Radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "inner_padding_desktop",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Inner Padding (Desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "inner_padding_mobile",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Inner Padding (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Outer Padding Top (Desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Outer Padding Bottom (Desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Outer Padding Top (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Outer Padding Bottom (Mobile)",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Step Number/Identifier",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pick a size"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Go pocket-size or choose the grand pull."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works (Steps)",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "number": "01",
            "title": "Pick a size",
            "description": "Go pocket-size or choose the grand pull."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "02",
            "title": "Share a little guidance",
            "description": "Tell us the age range, theme, and who it's for—or leave it entirely to chance."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "03",
            "title": "We pull & pack",
            "description": "We do our best to match available stock while keeping the collectible a genuine mystery."
          }
        }
      ]
    }
  ]
}
{% endschema %}
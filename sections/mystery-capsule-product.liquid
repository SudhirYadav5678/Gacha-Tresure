    min-width: 0;
    border: 0;
    color: var(--mp-text);
    background: transparent;
    text-align: center;
    font: inherit;
    font-weight: 800;
  }

  .mystery-quantity button {
    cursor: pointer;
  }

  .mystery-product__submit {
    min-height: 56px;
    padding: 0 24px;
    color: #fff;
    background: var(--mp-accent);
    border: 1px solid var(--mp-accent);
    font: inherit;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: .02em;
    cursor: pointer;
    transition: transform .2s ease, filter .2s ease;
  }

  .mystery-product__submit:hover:not(:disabled) {
    transform: translateY(-1px);
    filter: brightness(1.04);
  }

  .mystery-product__submit:disabled {
    opacity: .5;
    cursor: not-allowed;
  }

  .mystery-product__checkout {
    margin-top: -14px;
  }

  .mystery-benefits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid var(--mp-border);
  }

  .mystery-benefits div {

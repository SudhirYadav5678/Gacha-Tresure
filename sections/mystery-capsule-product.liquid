    padding: 18px;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 10px;
    row-gap: 3px;
  }

  .mystery-benefits div + div {
    border-left: 1px solid var(--mp-border);
  }

  .mystery-benefits span {
    color: var(--mp-accent);
    grid-row: span 2;
  }

  .mystery-benefits strong {
    font-size: 13px;
  }

  .mystery-benefits small {
    color: var(--mp-muted);
    font-size: 11px;
    line-height: 1.4;
  }

  .mystery-accordion {
    border-top: 1px solid var(--mp-border);
  }

  .mystery-accordion:last-child {
    border-bottom: 1px solid var(--mp-border);
  }

  .mystery-accordion summary {
    min-height: 58px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--mp-text);
    font-size: 14px;
    font-weight: 850;
    cursor: pointer;
    list-style: none;
  }

  .mystery-accordion summary::-webkit-details-marker {
    display: none;
  }

  .mystery-accordion[open] summary span {
    transform: rotate(45deg);
  }

  .mystery-accordion__content {
    padding-bottom: 22px;
    color: var(--mp-muted);
    font-size: 13px;
    line-height: 1.75;
  }

  .mystery-accordion__content p {
    margin: 0;
  }

  .mystery-product__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
  }

  .mystery-product button:focus-visible,
  .mystery-product input:focus-visible,
  .mystery-product select:focus-visible,
  .mystery-product summary:focus-visible {
    outline: 2px solid var(--mp-accent);
    outline-offset: 3px;
  }

  @media (max-width: 980px) {
    .mystery-product__inner {
      grid-template-columns: 1fr;
    }

    .mystery-product__info-column--sticky {
      position: static;
    }
  }

  @media (max-width: 767px) {
    .mystery-product__inner--page,
    .mystery-product__inner--wide {
      width: min(100% - 36px, var(--page-width, 1360px));
    }

    .mystery-product__media-stage {
      aspect-ratio: 1;
    }

    .mystery-product__media-stage--natural {
      min-height: auto;
    }

    .mystery-product__thumbs {
      grid-auto-columns: 42%;
      scroll-snap-type: x mandatory;
    }

    .mystery-product__thumb {
      scroll-snap-align: start;
    }

    .mystery-option-group__grid,
    .mystery-option-group__grid--2,
    .mystery-option-group__grid--3,
    .mystery-preferences__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mystery-config-row,
    .mystery-product__price-row {
      grid-template-columns: 1fr;
    }

    .mystery-product__buy-row,
    .mystery-benefits {
      grid-template-columns: 1fr;
    }


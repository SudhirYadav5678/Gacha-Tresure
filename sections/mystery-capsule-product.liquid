      border-top: 1px solid var(--mp-border);
    }
  }

  @media (max-width: 420px) {
    .mystery-preferences__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mystery-choice,
    .mystery-preference,
    .mystery-product__submit {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  class MysteryProductSection {
    constructor(root) {
      this.root = root;
      this.form = root.querySelector('[data-product-form]');
      this.variantInput = root.querySelector('[data-mystery-variant-id]');
      this.price = root.querySelector('[data-mystery-price]');
      this.submit = root.querySelector('[data-mystery-submit]');
      this.submitText = root.querySelector('[data-mystery-submit-text]');
      this.variants = this.readVariants();
      this.bindGallery();
      this.bindVariantPicker();
      this.bindQuantity();
    }

    readVariants() {
      const script = this.root.querySelector('[data-mystery-variants]');
      if (!script) return [];
      try {
        return JSON.parse(script.textContent);
      } catch (error) {
        return [];
      }
    }

    bindGallery() {
      const thumbs = this.root.querySelectorAll('[data-media-target]');
      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => this.showMedia(thumb.dataset.mediaTarget));
      });
    }

    showMedia(mediaId) {
      this.root.querySelectorAll('[data-media-id]').forEach((item) => {
        item.classList.toggle('is-active', item.dataset.mediaId === String(mediaId));
      });
      this.root.querySelectorAll('[data-media-target]').forEach((thumb) => {
        thumb.classList.toggle('is-active', thumb.dataset.mediaTarget === String(mediaId));
      });
      const active = this.root.querySelector(`[data-media-id="${mediaId}"]`);
      const counter = this.root.querySelector('[data-mystery-counter]');
      if (active && counter) {
        counter.textContent = counter.textContent.replace(/\d+\s+(?=\S+\s+\d+$)/, `${active.dataset.mediaIndex} `);
      }
    }

    bindVariantPicker() {
      this.root.querySelectorAll('[data-option-value]').forEach((input) => {
        input.addEventListener('change', () => this.updateVariant());
      });
      this.updateVariant();
    }

    selectedOptions() {
      return Array.from(this.root.querySelectorAll('[data-option-position]')).map((group) => {
        const checked = group.querySelector('[data-option-value]:checked');
        return checked ? checked.value : null;
      }).filter(Boolean);
    }

    updateVariant() {
      const selected = this.selectedOptions();
      const variant = this.variants.find((candidate) => {
        return candidate.options.every((value, index) => value === selected[index]);
      }) || this.variants[0];
      this.root.querySelectorAll('.mystery-choice').forEach((label) => {
        const input = label.querySelector('[data-option-value]');
        label.classList.toggle('is-selected', Boolean(input && input.checked));
      });
      if (!variant) return;
      if (this.variantInput) this.variantInput.value = variant.id;
      if (this.price) {
        this.price.innerHTML = variant.compareAtPrice ? `<s>${variant.compareAtPrice}</s><span>${variant.price}</span>` : `<span>${variant.price}</span>`;
      }
      if (this.submit) {
        this.submit.disabled = !variant.available;
      }
      if (this.submitText) {
        this.submitText.textContent = variant.available ? this.submitText.dataset.available || this.submitText.textContent : 'Sold out';
      }
      if (variant.featuredMediaId) {
        this.showMedia(variant.featuredMediaId);
      }
      const url = new URL(window.location.href);
      url.searchParams.set('variant', variant.id);
      window.history.replaceState({}, '', url.toString());
    }

    bindQuantity() {
      this.root.querySelectorAll('.mystery-quantity').forEach((quantity) => {
        const input = quantity.querySelector('input');
        const minus = quantity.querySelector('[name="minus"]');
        const plus = quantity.querySelector('[name="plus"]');
        if (!input || !minus || !plus) return;
        minus.addEventListener('click', () => {
          input.value = Math.max(Number(input.min || 1), Number(input.value || 1) - 1);
          input.dispatchEvent(new Event('change', { bubbles: true }));
        });
        plus.addEventListener('click', () => {
          input.value = Number(input.value || 1) + 1;
          input.dispatchEvent(new Event('change', { bubbles: true }));
        });
      });
    }
  }

  function initMysteryProducts(container = document) {
    container.querySelectorAll('[data-mystery-product]').forEach((root) => {
      if (root.dataset.mysteryInitialized) return;
      root.dataset.mysteryInitialized = 'true';
      new MysteryProductSection(root);
    });
  }

  initMysteryProducts();
  document.addEventListener('shopify:section:load', (event) => initMysteryProducts(event.target));
{% endjavascript %}


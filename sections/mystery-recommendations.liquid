{% liquid
  assign selected_products = section.settings.products
  assign selected_collection = section.settings.collection
%}

{% style %}
  #shopify-section-{{ section.id }} .mystery-recs {
    --mr-bg: {{ section.settings.background }};
    --mr-text: {{ section.settings.text_color }};
    --mr-muted: {{ section.settings.muted_text_color }};
    --mr-accent: {{ section.settings.accent_color }};
    --mr-border: {{ section.settings.border_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<section class="mystery-recs">
  <div class="mystery-recs__inner mystery-recs__inner--{{ section.settings.content_width }}">
    <div class="mystery-recs__header">
      {% if section.settings.eyebrow != blank %}
        <p>{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
    </div>

    <div class="mystery-recs__grid mystery-recs__grid--{{ section.settings.desktop_columns }}">
      {% if selected_products != blank %}
        {% for rec_product in selected_products limit: section.settings.products_to_show %}
          {% render 'mystery-recommendation-card', rec_product: rec_product %}
        {% endfor %}
      {% elsif selected_collection != blank %}
        {% for rec_product in selected_collection.products limit: section.settings.products_to_show %}
          {% unless rec_product.id == product.id %}
            {% render 'mystery-recommendation-card', rec_product: rec_product %}
          {% endunless %}
        {% endfor %}
      {% else %}
        {% for rec_product in product.collections.first.products limit: section.settings.products_to_show %}
          {% unless rec_product.id == product.id %}
            {% render 'mystery-recommendation-card', rec_product: rec_product %}
          {% endunless %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .mystery-recs {
    color: var(--mr-text);
    background: var(--mr-bg);
    font-family: var(--font-body-family, Inter, ui-sans-serif, system-ui, sans-serif);
  }

  .mystery-recs__inner {
    margin-inline: auto;
  }

  .mystery-recs__inner--page {
    width: min(var(--page-width, 1360px), calc(100vw - 96px));
  }

  .mystery-recs__inner--wide {
    width: min(1560px, calc(100vw - 64px));
  }

  .mystery-recs__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 36px;
  }

  .mystery-recs__header p {
    margin: 0;
    color: var(--mr-accent);
    font-size: 11px;
    font-weight: 850;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .mystery-recs__header h2 {
    max-width: 620px;
    margin: 0;
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(38px, 4vw, 62px);
    font-weight: 500;
    line-height: 1.05;
  }

  .mystery-recs__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px 18px;
  }

  .mystery-recs__grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .mystery-rec-card {
    min-width: 0;
  }

  .mystery-rec-card__media {
    aspect-ratio: 4 / 5;
    display: block;
    overflow: hidden;
    background: #eae0d4;
  }

  .mystery-rec-card__media img,
  .mystery-rec-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mystery-rec-card__placeholder {
    display: grid;
    place-items: center;
  }

  .mystery-rec-card__placeholder svg {
    width: 58%;
    opacity: .4;
  }

  .mystery-rec-card h3 {
    margin: 14px 0 0;
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: 22px;
    font-weight: 500;
    line-height: 1.15;
  }

  .mystery-rec-card a {
    color: inherit;
    text-decoration: none;
  }

  .mystery-rec-card__price {
    margin: 10px 0 0;
    color: var(--mr-muted);
    font-size: 12px;
    font-weight: 800;
  }

  .mystery-rec-card a:focus-visible {
    outline: 2px solid var(--mr-accent);
    outline-offset: 3px;
  }

  @media (max-width: 900px) {
    .mystery-recs__grid,
    .mystery-recs__grid--3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .mystery-recs__inner--page,
    .mystery-recs__inner--wide {
      width: min(100% - 36px, var(--page-width, 1360px));
    }

    .mystery-recs__header {
      display: block;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mystery recommendations",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "More to discover" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 8 },
    { "type": "collection", "id": "collection", "label": "Fallback collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "select", "id": "content_width", "label": "Content width", "default": "page", "options": [
      { "value": "page", "label": "Page width" },
      { "value": "wide", "label": "Wide" }
    ] },
    { "type": "select", "id": "desktop_columns", "label": "Desktop columns", "default": "4", "options": [
      { "value": "3", "label": "3" },
      { "value": "4", "label": "4" }
    ] },
    { "type": "color", "id": "background", "label": "Background", "default": "#F8F2E9" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#291820" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text", "default": "#74676D" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#C73F76" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#D9CEC3" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 36, "max": 140, "step": 4, "unit": "px", "default": 84 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 36, "max": 140, "step": 4, "unit": "px", "default": 100 }
  ],
  "presets": [
    { "name": "Mystery recommendations" }
  ]
}
{% endschema %}

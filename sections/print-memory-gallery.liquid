{% style %}
  #shopify-section-{{ section.id }} .print-memory {
    --pm-bg: {{ section.settings.background }};
    --pm-heading: {{ section.settings.heading_color }};
    --pm-accent: {{ section.settings.accent_color }};
    --pm-body: {{ section.settings.body_color }};
    --pm-overlay: {{ section.settings.card_overlay | divided_by: 100.0 }};
    --pm-gap: {{ section.settings.card_gap }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .print-memory {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{% endstyle %}

<section class="print-memory">
  <div class="print-memory__inner print-memory__inner--{{ section.settings.content_width }}">
    <div class="print-memory__copy print-memory__copy--{{ section.settings.alignment }}">
      {% if section.settings.eyebrow != blank %}
        <p class="print-memory__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank or section.settings.accent_heading != blank %}
        <h2>
          {% if section.settings.heading != blank %}<span>{{ section.settings.heading }}</span>{% endif %}
          {% if section.settings.accent_heading != blank %}<em>{{ section.settings.accent_heading }}</em>{% endif %}
        </h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="print-memory__body">{{ section.settings.body }}</div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="print-memory__grid print-memory__grid--mobile-{{ section.settings.mobile_columns }}">
        {% for block in section.blocks %}
          <article class="print-memory-card print-memory-card--{{ block.settings.aspect_ratio }}" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '#' }}" {% if block.settings.link == blank %}aria-disabled="true"{% endif %}>
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1000 | image_tag: widths: '360, 540, 720, 900, 1000', sizes: '(max-width: 767px) 90vw, 28vw', loading: 'lazy', class: 'print-memory-card__image' }}
              {% else %}
                <span class="print-memory-card__placeholder">{{ 'collection-1' | placeholder_svg_tag }}</span>
              {% endif %}
              <span class="print-memory-card__shade"></span>
              <span class="print-memory-card__caption">
                {% if block.settings.badge != blank %}<small>{{ block.settings.badge }}</small>{% endif %}
                {% if block.settings.heading != blank %}<strong>{{ block.settings.heading }}</strong>{% endif %}
                {% if block.settings.description != blank %}<em>{{ block.settings.description }}</em>{% endif %}
              </span>
            </a>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .print-memory {
    color: var(--pm-body);
    background: var(--pm-bg);
    font-family: var(--font-body-family, Inter, ui-sans-serif, system-ui, sans-serif);
  }

  .print-memory__inner {
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(260px, .42fr) minmax(0, 1fr);
    gap: clamp(38px, 8vw, 110px);
    align-items: center;
  }

  .print-memory__inner--page {
    width: min(var(--page-width, 1360px), calc(100vw - 96px));
  }

  .print-memory__inner--wide {
    width: min(1560px, calc(100vw - 64px));
  }

  .print-memory__copy {
    max-width: 460px;
  }

  .print-memory__copy--center {
    text-align: center;
  }

  .print-memory__eyebrow {
    margin: 0 0 22px;
    color: var(--pm-body);
    font-size: 11px;
    font-weight: 850;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .print-memory h2 {
    margin: 0;
    color: var(--pm-heading);
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(42px, 5vw, 78px);
    font-weight: 500;
    line-height: .98;
  }

  .print-memory h2 span,
  .print-memory h2 em {
    display: block;
  }

  .print-memory h2 em {
    color: var(--pm-accent);
    font-style: italic;
  }

  .print-memory__body {
    margin-top: 24px;
    color: var(--pm-body);
    font-size: 14px;
    line-height: 1.75;
    opacity: .78;
  }

  .print-memory__body p {
    margin: 0;
  }

  .print-memory__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--pm-gap);
  }

  .print-memory-card {
    min-width: 0;
  }

  .print-memory-card a {
    position: relative;
    min-height: 100%;
    display: block;
    overflow: hidden;
    color: var(--pm-heading);
    text-decoration: none;
  }

  .print-memory-card--portrait a {
    aspect-ratio: 4 / 5;
  }

  .print-memory-card--square a {
    aspect-ratio: 1;
  }

  .print-memory-card--wide a {
    aspect-ratio: 16 / 11;
  }

  .print-memory-card__image,
  .print-memory-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .45s ease;
  }

  .print-memory-card__placeholder {
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #4d183a, #120711);
  }

  .print-memory-card__placeholder svg {
    width: 46%;
    opacity: .35;
  }

  .print-memory-card__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(36,9,29,.74), transparent 58%);
    opacity: var(--pm-overlay);
  }

  .print-memory-card__caption {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
    display: grid;
    gap: 4px;
  }

  .print-memory-card__caption small {
    color: var(--pm-accent);
    font-size: 10px;
    font-weight: 850;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .print-memory-card__caption strong {
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.1;
  }

  .print-memory-card__caption em {
    font-size: 12px;
    font-style: normal;
    opacity: .78;
  }

  .print-memory-card a:hover .print-memory-card__image {
    transform: scale(1.035);
  }

  .print-memory-card a:focus-visible {
    outline: 2px solid var(--pm-accent);
    outline-offset: 3px;
  }

  @media (max-width: 980px) {
    .print-memory__inner {
      grid-template-columns: 1fr;
    }

    .print-memory__copy {
      max-width: 720px;
    }
  }

  @media (max-width: 767px) {
    .print-memory__inner--page,
    .print-memory__inner--wide {
      width: min(100% - 36px, var(--page-width, 1360px));
    }

    .print-memory__grid,
    .print-memory__grid--mobile-1 {
      grid-template-columns: 1fr;
    }

    .print-memory__grid--mobile-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .print-memory-card__caption strong {
      font-size: 20px;
    }
  }

  @media (max-width: 430px) {
    .print-memory__grid--mobile-2 {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .print-memory-card__image {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Memory Gallery",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made to mean something" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Your photo becomes" },
    { "type": "inline_richtext", "id": "accent_heading", "label": "Accent heading", "default": "the light in the room." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>From quiet remembrance to joyful milestones, each piece begins with an image worth keeping.</p>" },
    { "type": "select", "id": "content_width", "label": "Content width", "default": "page", "options": [
      { "value": "page", "label": "Page width" },
      { "value": "wide", "label": "Wide" }
    ] },
    { "type": "select", "id": "alignment", "label": "Copy alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ] },
    { "type": "select", "id": "mobile_columns", "label": "Mobile columns", "default": "1", "options": [
      { "value": "1", "label": "1" },
      { "value": "2", "label": "2" }
    ] },
    { "type": "range", "id": "card_gap", "label": "Card gap", "min": 8, "max": 28, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "card_overlay", "label": "Card overlay", "min": 20, "max": 90, "step": 5, "unit": "%", "default": 80 },
    { "type": "color", "id": "background", "label": "Background", "default": "#24091D" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#FBF7F0" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#E7A7BF" },
    { "type": "color", "id": "body_color", "label": "Body", "default": "#FBF7F0" },
    { "type": "range", "id": "padding_top", "label": "Desktop padding top", "min": 60, "max": 180, "step": 4, "unit": "px", "default": 116 },
    { "type": "range", "id": "padding_bottom", "label": "Desktop padding bottom", "min": 60, "max": 180, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile padding top", "min": 42, "max": 120, "step": 2, "unit": "px", "default": 70 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile padding bottom", "min": 42, "max": 120, "step": 2, "unit": "px", "default": 76 }
  ],
  "blocks": [
    {
      "type": "memory",
      "name": "Memory card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Pet memorials" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Pet memorials" },
        { "type": "text", "id": "description", "label": "Description", "default": "A warm light for a much-loved companion." },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "aspect_ratio", "label": "Aspect ratio", "default": "square", "options": [
          { "value": "square", "label": "Square" },
          { "value": "portrait", "label": "Portrait" },
          { "value": "wide", "label": "Wide" }
        ] }
      ]
    }
  ],
  "presets": [
    {
      "name": "Memory Gallery",
      "blocks": [
        { "type": "memory", "settings": { "badge": "Pet memorials", "heading": "Pet memorials", "description": "A warm light for a much-loved companion.", "aspect_ratio": "portrait" } },
        { "type": "memory", "settings": { "badge": "Weddings", "heading": "Weddings and anniversaries", "description": "Preserve a meaningful celebration in warm light.", "aspect_ratio": "square" } },
        { "type": "memory", "settings": { "badge": "Family memories", "heading": "Family memories", "description": "Turn a favorite photo into a personal keepsake.", "aspect_ratio": "wide" } },
        { "type": "memory", "settings": { "badge": "Original artwork", "heading": "Original artwork", "description": "Transform illustrations into illuminated pieces.", "aspect_ratio": "portrait" } }
      ]
    }
  ]
}
{% endschema %}

{% style %}
  #shopify-section-{{ section.id }} .print-process {
    --pp-bg: {{ section.settings.background }};
    --pp-text: {{ section.settings.text_color }};
    --pp-muted: {{ section.settings.muted_text_color }};
    --pp-accent: {{ section.settings.accent_color }};
    --pp-border: {{ section.settings.border_color }};
    --pp-heading-desktop: {{ section.settings.heading_size_desktop }}px;
    --pp-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --pp-card-padding: {{ section.settings.card_padding }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .print-process {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{% endstyle %}

<section class="print-process">
  <div class="print-process__inner print-process__inner--{{ section.settings.content_width }}">
    <div class="print-process__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="print-process__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank or section.settings.accent_heading != blank %}
        <h2>
          {% if section.settings.heading != blank %}<span>{{ section.settings.heading }}</span>{% endif %}
          {% if section.settings.accent_heading != blank %}<em>{{ section.settings.accent_heading }}</em>{% endif %}
        </h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="print-process__body">{{ section.settings.body }}</div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="print-process__steps print-process__steps--{{ section.settings.desktop_columns }}">
        {% for block in section.blocks %}
          <article class="print-process-step" {{ block.shopify_attributes }}>
            {% if section.settings.show_numbers %}
              <p>{{ block.settings.number }}</p>
            {% endif %}
            {% if section.settings.show_icons and block.settings.icon != blank %}
              <span aria-hidden="true">{{ block.settings.icon }}</span>
            {% endif %}
            <h3>{{ block.settings.heading }}</h3>
            <div>{{ block.settings.text }}</div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .print-process {
    color: var(--pp-text);
    background: var(--pp-bg);
    font-family: var(--font-body-family, Inter, ui-sans-serif, system-ui, sans-serif);
  }

  .print-process__inner {
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(260px, .42fr) minmax(0, 1fr);
    gap: clamp(36px, 8vw, 110px);
    align-items: center;
  }

  .print-process__inner--page {
    width: min(var(--page-width, 1360px), calc(100vw - 96px));
  }

  .print-process__inner--wide {
    width: min(1560px, calc(100vw - 64px));
  }

  .print-process__eyebrow {
    margin: 0 0 22px;
    color: var(--pp-muted);
    font-size: 11px;
    font-weight: 850;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .print-process h2 {
    margin: 0;
    color: var(--pp-text);
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(var(--pp-heading-mobile), 5vw, var(--pp-heading-desktop));
    font-weight: 500;
    line-height: 1;
  }

  .print-process h2 span,
  .print-process h2 em {
    display: block;
  }

  .print-process h2 em {
    color: var(--pp-accent);
    font-style: italic;
  }

  .print-process__body {
    max-width: 520px;
    margin-top: 22px;
    color: var(--pp-muted);
    font-size: 14px;
    line-height: 1.75;
  }

  .print-process__body p,
  .print-process-step div p {
    margin: 0;
  }

  .print-process__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--pp-border);
  }

  .print-process__steps--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .print-process-step {
    min-width: 0;
    padding: var(--pp-card-padding);
    border-right: 1px solid var(--pp-border);
  }

  .print-process-step:last-child {
    border-right: 0;
  }

  .print-process-step p {
    margin: 0 0 48px;
    color: var(--pp-accent);
    font-size: 11px;
    font-weight: 850;
    letter-spacing: .12em;
  }

  .print-process-step span {
    display: block;
    margin-bottom: 18px;
    color: var(--pp-accent);
    font-size: 24px;
  }

  .print-process-step h3 {
    margin: 0 0 8px;
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.15;
  }

  .print-process-step div {
    color: var(--pp-muted);
    font-size: 12px;
    line-height: 1.6;
  }

  @media (max-width: 980px) {
    .print-process__inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .print-process__inner--page,
    .print-process__inner--wide {
      width: min(100% - 36px, var(--page-width, 1360px));
    }

    .print-process__steps,
    .print-process__steps--2 {
      grid-template-columns: 1fr;
    }

    .print-process-step,
    .print-process-step:last-child {
      border-right: 0;
      border-bottom: 1px solid var(--pp-border);
    }

    .print-process-step:last-child {
      border-bottom: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Print Process",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A human-guided custom process" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Upload. Refine." },
    { "type": "inline_richtext", "id": "accent_heading", "label": "Accent heading", "default": "Approve. Illuminate." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Our team turns your image into a print-ready relief and gives you a chance to review the result before production.</p>" },
    { "type": "select", "id": "content_width", "label": "Content width", "default": "page", "options": [
      { "value": "page", "label": "Page width" },
      { "value": "wide", "label": "Wide" }
    ] },
    { "type": "select", "id": "desktop_columns", "label": "Desktop columns", "default": "3", "options": [
      { "value": "2", "label": "2" },
      { "value": "3", "label": "3" }
    ] },
    { "type": "checkbox", "id": "show_numbers", "label": "Show numbers", "default": true },
    { "type": "checkbox", "id": "show_icons", "label": "Show icons", "default": true },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size desktop", "min": 44, "max": 82, "step": 2, "unit": "px", "default": 62 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size mobile", "min": 34, "max": 56, "step": 2, "unit": "px", "default": 42 },
    { "type": "range", "id": "card_padding", "label": "Card padding", "min": 20, "max": 52, "step": 4, "unit": "px", "default": 36 },
    { "type": "color", "id": "background", "label": "Background", "default": "#F7F0E7" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2B1823" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text", "default": "#73656C" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#D47A9E" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#DED2C8" },
    { "type": "range", "id": "padding_top", "label": "Desktop padding top", "min": 48, "max": 160, "step": 4, "unit": "px", "default": 108 },
    { "type": "range", "id": "padding_bottom", "label": "Desktop padding bottom", "min": 48, "max": 160, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile padding top", "min": 36, "max": 100, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile padding bottom", "min": 36, "max": 100, "step": 2, "unit": "px", "default": 68 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process step",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "icon", "label": "Icon", "default": "*" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Share your photo" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Upload a clear image and tell us the story behind it.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Print Process",
      "blocks": [
        { "type": "step", "settings": { "number": "01", "icon": "camera", "heading": "Share your photo", "text": "<p>Upload a clear image and tell us the story behind it.</p>" } },
        { "type": "step", "settings": { "number": "02", "icon": "spark", "heading": "We prepare the relief", "text": "<p>Our team improves contrast and composition for a stronger print.</p>" } },
        { "type": "step", "settings": { "number": "03", "icon": "layers", "heading": "Approve before print", "text": "<p>Review the prepared artwork before final production.</p>" } }
      ]
    }
  ]
}
{% endschema %}

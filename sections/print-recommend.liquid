{% liquid
  assign manual_products = section.settings.products
  assign source_collection = section.settings.collection
%}

{% style %}
  #shopify-section-{{ section.id }} .print-recommend {
    --pr-bg: {{ section.settings.background }};
    --pr-text: {{ section.settings.text_color }};
    --pr-muted: {{ section.settings.muted_text_color }};
    --pr-accent: {{ section.settings.accent_color }};
    --pr-gap: {{ section.settings.gap }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<section class="print-recommend">
  <div class="print-recommend__inner print-recommend__inner--{{ section.settings.content_width }}">
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="print-recommend__grid print-recommend__grid--{{ section.settings.desktop_columns }}">
      {% if manual_products != blank %}
        {% for rec_product in manual_products limit: section.settings.products_to_show %}
          <article class="print-rec-card">
            <a href="{{ rec_product.url }}">
              <span class="print-rec-card__media">
                {% if rec_product.featured_image != blank %}
                  {{ rec_product.featured_image | image_url: width: 700 | image_tag: widths: '320, 480, 640, 700', sizes: '(max-width: 767px) 50vw, 25vw', loading: 'lazy' }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag }}
                {% endif %}
              </span>
              <strong>{{ rec_product.title }}</strong>
              {% if section.settings.show_price %}
                <small>{% if rec_product.price_varies %}From {{ rec_product.price_min | money }}{% else %}{{ rec_product.price | money }}{% endif %}</small>
              {% endif %}
            </a>
          </article>
        {% endfor %}
      {% elsif source_collection != blank %}
        {% for rec_product in source_collection.products limit: section.settings.products_to_show %}
          <article class="print-rec-card">
            <a href="{{ rec_product.url }}">
              <span class="print-rec-card__media">
                {% if rec_product.featured_image != blank %}
                  {{ rec_product.featured_image | image_url: width: 700 | image_tag: widths: '320, 480, 640, 700', sizes: '(max-width: 767px) 50vw, 25vw', loading: 'lazy' }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag }}
                {% endif %}
              </span>
              <strong>{{ rec_product.title }}</strong>
              {% if section.settings.show_price %}
                <small>{% if rec_product.price_varies %}From {{ rec_product.price_min | money }}{% else %}{{ rec_product.price | money }}{% endif %}</small>
              {% endif %}
            </a>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .print-recommend {
    color: var(--pr-text);
    background: var(--pr-bg);
    font-family: var(--font-body-family, Inter, ui-sans-serif, system-ui, sans-serif);
  }

  .print-recommend__inner {
    margin-inline: auto;
  }

  .print-recommend__inner--page {
    width: min(var(--page-width, 1360px), calc(100vw - 96px));
  }

  .print-recommend__inner--wide {
    width: min(1560px, calc(100vw - 64px));
  }

  .print-recommend h2 {
    margin: 0 0 34px;
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(34px, 4vw, 60px);
    font-weight: 500;
    line-height: 1.05;
  }

  .print-recommend__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--pr-gap);
  }

  .print-recommend__grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .print-rec-card a {
    display: grid;
    gap: 12px;
    color: inherit;
    text-decoration: none;
  }

  .print-rec-card__media {
    aspect-ratio: 4 / 5;
    display: block;
    overflow: hidden;
    background: #ded2c8;
  }

  .print-rec-card__media img,
  .print-rec-card__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .print-rec-card strong {
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: 22px;
    font-weight: 500;
    line-height: 1.15;
  }

  .print-rec-card small {
    color: var(--pr-muted);
    font-size: 12px;
    font-weight: 850;
  }

  .print-rec-card a:focus-visible {
    outline: 2px solid var(--pr-accent);
    outline-offset: 3px;
  }

  @media (max-width: 900px) {
    .print-recommend__grid,
    .print-recommend__grid--3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .print-recommend__inner--page,
    .print-recommend__inner--wide {
      width: min(100% - 36px, var(--page-width, 1360px));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Print Recommend",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "More from the studio" },
    { "type": "product_list", "id": "products", "label": "Manual products", "limit": 8 },
    { "type": "collection", "id": "collection", "label": "Collection source" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true },
    { "type": "select", "id": "content_width", "label": "Content width", "default": "page", "options": [
      { "value": "page", "label": "Page width" },
      { "value": "wide", "label": "Wide" }
    ] },
    { "type": "select", "id": "desktop_columns", "label": "Desktop columns", "default": "4", "options": [
      { "value": "3", "label": "3" },
      { "value": "4", "label": "4" }
    ] },
    { "type": "range", "id": "gap", "label": "Gap", "min": 12, "max": 40, "step": 2, "unit": "px", "default": 22 },
    { "type": "color", "id": "background", "label": "Background", "default": "#F7F0E7" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2B1823" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text", "default": "#73656C" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#D47A9E" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 40, "max": 140, "step": 4, "unit": "px", "default": 76 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 40, "max": 140, "step": 4, "unit": "px", "default": 96 }
  ],
  "presets": [
    { "name": "Print Recommend" }
  ]
}
{% endschema %}

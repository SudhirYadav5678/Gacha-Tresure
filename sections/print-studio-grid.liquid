{% style %}
  #shopify-section-{{ section.id }} .print-studio {
    --ps-bg: {{ section.settings.background }};
    --ps-text: {{ section.settings.text_color }};
    --ps-muted: {{ section.settings.muted_text_color }};
    --ps-accent: {{ section.settings.accent_color }};
    --ps-card-text: {{ section.settings.card_text_color }};
    --ps-border: {{ section.settings.border_color }};
    --ps-overlay: {{ section.settings.card_overlay | divided_by: 100.0 }};
    --ps-gap: {{ section.settings.desktop_gap }}px;
    --ps-mobile-gap: {{ section.settings.mobile_gap }}px;
    --ps-radius: {{ section.settings.card_radius }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .print-studio {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{% endstyle %}

<section class="print-studio">
  <div class="print-studio__inner print-studio__inner--{{ section.settings.content_width }}">
    <div class="print-studio__intro print-studio__intro--{{ section.settings.alignment }}">
      {% if section.settings.eyebrow != blank %}
        <p>{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank or section.settings.accent_heading != blank %}
        <h2>
          {% if section.settings.heading != blank %}<span>{{ section.settings.heading }}</span>{% endif %}
          {% if section.settings.accent_heading != blank %}<em>{{ section.settings.accent_heading }}</em>{% endif %}
        </h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <div>{{ section.settings.body }}</div>
      {% endif %}
    </div>

    <div class="print-studio__cards">
      {% for block in section.blocks %}
        {% liquid
          assign card_url = block.settings.button_link
          if card_url == blank and block.settings.product != blank
            assign card_url = block.settings.product.url
          endif
          if card_url == blank and block.settings.collection != blank
            assign card_url = block.settings.collection.url
          endif
        %}
        <article class="print-studio-card print-studio-card--{{ block.settings.card_size }} print-studio-card--{{ block.settings.card_style }}" {{ block.shopify_attributes }}>
          <a href="{% if card_url != blank %}{{ card_url }}{% else %}#{% endif %}" {% if card_url == blank %}aria-disabled="true"{% endif %}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1200 | image_tag: widths: '360, 540, 720, 900, 1200', sizes: '(max-width: 767px) 90vw, 38vw', loading: 'lazy', class: 'print-studio-card__image' }}
            {% else %}
              <span class="print-studio-card__placeholder">{{ 'collection-1' | placeholder_svg_tag }}</span>
            {% endif %}
            <span class="print-studio-card__shade"></span>
            {% if block.settings.badge != blank %}
              <span class="print-studio-card__badge">{{ block.settings.badge }}</span>
            {% endif %}
            {% if block.settings.icon != blank %}
              <span class="print-studio-card__icon" aria-hidden="true">{{ block.settings.icon }}</span>
            {% endif %}
            <span class="print-studio-card__content">
              {% if block.settings.eyebrow != blank %}<small>{{ block.settings.eyebrow }}</small>{% endif %}
              {% if block.settings.heading != blank %}<strong>{{ block.settings.heading }}</strong>{% endif %}
              {% if block.settings.description != blank %}<em>{{ block.settings.description }}</em>{% endif %}
              {% if block.settings.button_label != blank %}<b>{{ block.settings.button_label }}</b>{% endif %}
            </span>
          </a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .print-studio {
    color: var(--ps-text);
    background: var(--ps-bg);
    font-family: var(--font-body-family, Inter, ui-sans-serif, system-ui, sans-serif);
  }

  .print-studio__inner {
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(240px, .34fr) minmax(0, 1fr);
    gap: var(--ps-gap);
    align-items: center;
  }

  .print-studio__inner--page {
    width: min(var(--page-width, 1360px), calc(100vw - 96px));
  }

  .print-studio__inner--wide {
    width: min(1560px, calc(100vw - 64px));
  }

  .print-studio__intro p {
    margin: 0 0 18px;
    color: var(--ps-muted);
    font-size: 11px;
    font-weight: 850;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .print-studio__intro h2 {
    margin: 0;
    color: var(--ps-text);
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(40px, 5vw, 72px);
    font-weight: 500;
    line-height: 1;
  }

  .print-studio__intro h2 span,
  .print-studio__intro h2 em {
    display: block;
  }

  .print-studio__intro h2 em {
    color: var(--ps-accent);
    font-style: italic;
  }

  .print-studio__intro div {
    max-width: 360px;
    margin-top: 22px;
    color: var(--ps-muted);
    font-size: 13px;
    line-height: 1.75;
  }

  .print-studio__intro div p {
    margin: 0;
  }

  .print-studio__intro--center {
    text-align: center;
  }

  .print-studio__cards {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(260px, .82fr);
    grid-template-rows: repeat(2, minmax(220px, 1fr));
    gap: var(--ps-gap);
  }

  .print-studio-card {
    min-width: 0;
  }

  .print-studio-card--large {
    grid-row: span 2;
  }

  .print-studio-card a {
    position: relative;
    min-height: 100%;
    display: block;
    overflow: hidden;
    color: var(--ps-card-text);
    background: #310b26;
    border: 1px solid var(--ps-border);
    border-radius: var(--ps-radius);
    text-decoration: none;
  }

  .print-studio-card__image,
  .print-studio-card__placeholder {
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
    transition: transform .45s ease;
  }

  .print-studio-card--large .print-studio-card__image,
  .print-studio-card--large .print-studio-card__placeholder {
    min-height: 500px;
  }

  .print-studio-card__placeholder {
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #4d183a, #160812);
  }

  .print-studio-card__placeholder svg {
    width: 44%;
    opacity: .35;
  }

  .print-studio-card__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(36,9,29,.8), rgba(36,9,29,.12));
    opacity: var(--ps-overlay);
  }

  .print-studio-card:hover .print-studio-card__image {
    transform: scale(1.035);
  }

  .print-studio-card__badge,
  .print-studio-card__icon {
    position: absolute;
    z-index: 2;
    top: 18px;
  }

  .print-studio-card__badge {
    left: 18px;
    padding: 7px 10px;
    color: #24091d;
    background: var(--ps-accent);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .print-studio-card__icon {
    right: 18px;
    color: rgba(255,255,255,.78);
    font-size: 34px;
  }

  .print-studio-card__content {
    position: absolute;
    z-index: 2;
    left: 22px;
    right: 22px;
    bottom: 22px;
    display: grid;
    gap: 8px;
  }

  .print-studio-card__content small {
    color: var(--ps-accent);
    font-size: 10px;
    font-weight: 850;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .print-studio-card__content strong {
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(28px, 3vw, 48px);
    font-weight: 500;
    line-height: 1;
  }

  .print-studio-card--small .print-studio-card__content strong {
    font-size: clamp(24px, 2vw, 32px);
  }

  .print-studio-card__content em {
    max-width: 520px;
    font-size: 12px;
    font-style: normal;
    line-height: 1.5;
    opacity: .82;
  }

  .print-studio-card__content b {
    margin-top: 6px;
    font-size: 11px;
    font-weight: 850;
    letter-spacing: .04em;
  }

  .print-studio-card a:focus-visible {
    outline: 2px solid var(--ps-accent);
    outline-offset: 3px;
  }

  @media (max-width: 980px) {
    .print-studio__inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .print-studio__inner--page,
    .print-studio__inner--wide {
      width: min(100% - 36px, var(--page-width, 1360px));
      gap: 32px;
    }

    .print-studio__cards {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: var(--ps-mobile-gap);
    }

    .print-studio-card--large {
      grid-row: auto;
    }

    .print-studio-card__image,
    .print-studio-card__placeholder,
    .print-studio-card--large .print-studio-card__image,
    .print-studio-card--large .print-studio-card__placeholder {
      min-height: 320px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .print-studio-card__image {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Print Studio Grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Explore 3D prints" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "One studio." },
    { "type": "inline_richtext", "id": "accent_heading", "label": "Accent heading", "default": "Growing possibilities." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Every 3D print category is designed as its own experience with products, first, then a tailored gallery showing what is possible.</p>" },
    { "type": "select", "id": "content_width", "label": "Content width", "default": "page", "options": [
      { "value": "page", "label": "Page width" },
      { "value": "wide", "label": "Wide" }
    ] },
    { "type": "select", "id": "alignment", "label": "Intro alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ] },
    { "type": "range", "id": "desktop_gap", "label": "Desktop gap", "min": 12, "max": 48, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "mobile_gap", "label": "Mobile gap", "min": 12, "max": 36, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 8, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "card_overlay", "label": "Card overlay", "min": 20, "max": 90, "step": 5, "unit": "%", "default": 75 },
    { "type": "color", "id": "background", "label": "Background", "default": "#F7F0E7" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2B1823" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text", "default": "#73656C" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#D47A9E" },
    { "type": "color", "id": "card_text_color", "label": "Card text", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#DED2C8" },
    { "type": "range", "id": "padding_top", "label": "Desktop padding top", "min": 48, "max": 160, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Desktop padding bottom", "min": 48, "max": 160, "step": 4, "unit": "px", "default": 112 },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile padding top", "min": 36, "max": 100, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile padding bottom", "min": 36, "max": 100, "step": 2, "unit": "px", "default": 70 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Studio card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Available now" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "01 - custom photo solution" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Lithophanes" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Custom illuminated portraits, memories, celebrations, and original art." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Enter the lithophane studio" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "product", "id": "product", "label": "Product link" },
        { "type": "collection", "id": "collection", "label": "Collection link" },
        { "type": "text", "id": "icon", "label": "Icon text" },
        { "type": "select", "id": "card_size", "label": "Card size", "default": "large", "options": [
          { "value": "large", "label": "Large" },
          { "value": "small", "label": "Small" }
        ] },
        { "type": "select", "id": "card_style", "label": "Card style", "default": "feature", "options": [
          { "value": "feature", "label": "Feature" },
          { "value": "promo", "label": "Promo" }
        ] }
      ]
    }
  ],
  "presets": [
    {
      "name": "Print Studio Grid",
      "blocks": [
        { "type": "card", "settings": { "card_size": "large", "badge": "Available now", "heading": "Lithophanes", "description": "Custom illuminated portraits, memories, celebrations, and original art.", "button_label": "Enter the lithophane studio" } },
        { "type": "card", "settings": { "card_size": "small", "badge": "Future collection", "heading": "Animal Miniatures", "description": "Custom and collectible creatures inspired by photos and ideas.", "button_label": "Coming to the studio", "icon": "layers" } },
        { "type": "card", "settings": { "card_size": "small", "badge": "Your studio. Your idea.", "heading": "What should we print next?", "description": "Share future 3D print ideas for the studio.", "button_label": "Share an idea", "icon": "cube" } }
      ]
    }
  ]
}
{% endschema %}

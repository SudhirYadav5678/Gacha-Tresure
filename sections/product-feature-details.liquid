          "min": 20,
          "max": 60,
          "step": 2,
          "unit": "px",
          "label": "Heading Size (Desktop)",
          "default": 36
        },

        {
          "type": "range",
          "id": "heading_size_mobile",
          "min": 16,
          "max": 40,
          "step": 1,
          "unit": "px",
          "label": "Heading Size (Mobile)",
          "default": 24
        }

      ]
    },

    {
      "type": "description",
      "name": "Product Description",
      "limit": 1
    },

    {
      "type": "notice",
      "name": "Notice Box",
      "limit": 1,

      "settings": [

        {
          "type": "text",
          "id": "title",
          "label": "Notice Title",
          "default": "Collection preview"
        },

        {
          "type": "text",
          "id": "text",
          "label": "Notice Text",
          "default": "Price, stock, and purchase options are awaiting confirmation. Images show the series, not guaranteed box contents."
        },

        {
          "type": "color",
          "id": "bg_color",
          "label": "Background Color",
          "default": "#F8EBF0"
        },

        {
          "type": "color",
          "id": "border_color",
          "label": "Border & Title Color",
          "default": "#9C3B61"
        }

      ]
    },

    {
      "type": "button",
      "name": "Action Button",
      "limit": 1,

      "settings": [


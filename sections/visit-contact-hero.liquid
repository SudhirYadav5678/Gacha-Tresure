{% liquid
  assign hero_image = section.settings.image
  assign mobile_image = section.settings.mobile_image | default: hero_image
%}

{% style %}
  #shopify-section-{{ section.id }} .visit-hero {
    --vh-bg: {{ section.settings.background }};
    --vh-heading: {{ section.settings.heading_color }};
    --vh-accent: {{ section.settings.accent_color }};
    --vh-body: {{ section.settings.body_color }};
    --vh-border: {{ section.settings.border_color }};
    --vh-primary-bg: {{ section.settings.primary_background }};
    --vh-primary-text: {{ section.settings.primary_text }};
    --vh-secondary-bg: {{ section.settings.secondary_background }};
    --vh-secondary-text: {{ section.settings.secondary_text }};
    --vh-badge-bg: {{ section.settings.badge_background }};
    --vh-badge-text: {{ section.settings.badge_text_color }};
    --vh-gap: {{ section.settings.column_gap }}px;
    --vh-left: {{ section.settings.left_column }}fr;
    --vh-right: {{ section.settings.right_column }}fr;
    --vh-heading-desktop: {{ section.settings.heading_size_desktop }}px;
    --vh-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --vh-body-size: {{ section.settings.body_size }}px;
    --vh-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --vh-radius: {{ section.settings.image_radius }}px;
    --vh-ratio: {{ section.settings.image_ratio }}%;
    --vh-focal: {{ section.settings.image_position }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .visit-hero {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{% endstyle %}

<section class="visit-hero visit-hero--{{ section.settings.mobile_order }}">
  <div class="visit-hero__inner visit-hero__inner--{{ section.settings.content_width }} visit-hero__inner--{{ section.settings.vertical_alignment }}">
    <div class="visit-hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="visit-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank or section.settings.accent_heading != blank %}
        <h1>
          {% if section.settings.heading != blank %}<span>{{ section.settings.heading }}</span>{% endif %}
          {% if section.settings.accent_heading != blank %}<em>{{ section.settings.accent_heading }}</em>{% endif %}
        </h1>
      {% endif %}

      {% if section.settings.body != blank %}
        <div class="visit-hero__body">{{ section.settings.body }}</div>
      {% endif %}

      {% if section.settings.primary_label != blank or section.settings.secondary_label != blank %}
        <div class="visit-hero__actions">
          {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}
            <a class="visit-hero__button visit-hero__button--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
          {% endif %}
          {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
            <a class="visit-hero__button visit-hero__button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <div class="visit-hero__media">
      {% if hero_image != blank %}
        <picture>
          {% if mobile_image != blank %}
            <source media="(max-width: 767px)" srcset="{{ mobile_image | image_url: width: 900 }}">
          {% endif %}
          {{ hero_image | image_url: width: 1600 | image_tag: widths: '540, 720, 900, 1200, 1600', sizes: '(min-width: 990px) 52vw, 100vw', loading: 'eager', class: 'visit-hero__image', alt: section.settings.image_alt }}
        </picture>
      {% else %}
        <div class="visit-hero__empty" aria-hidden="true"></div>
      {% endif %}
      {% if section.settings.show_badge and section.settings.badge_text != blank %}
        <div class="visit-hero__badge visit-hero__badge--{{ section.settings.badge_position }}">{{ section.settings.badge_text }}</div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .visit-hero {
    color: var(--vh-body);
    background: var(--vh-bg);
    font-family: var(--font-body-family, Inter, ui-sans-serif, system-ui, sans-serif);
  }

  .visit-hero__inner {
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, var(--vh-left)) minmax(0, var(--vh-right));
    gap: var(--vh-gap);
  }

  .visit-hero__inner--page {
    width: min(var(--page-width, 1360px), calc(100vw - 96px));
  }

  .visit-hero__inner--wide {
    width: min(1560px, calc(100vw - 64px));
  }

  .visit-hero__inner--top {
    align-items: start;
  }

  .visit-hero__inner--center {
    align-items: center;
  }

  .visit-hero__inner--bottom {
    align-items: end;
  }

  .visit-hero__eyebrow {
    margin: 0 0 22px;
    color: var(--vh-body);
    font-size: var(--vh-eyebrow-size);
    font-weight: 850;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .visit-hero h1 {
    margin: 0;
    color: var(--vh-heading);
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(var(--vh-heading-mobile), 6.2vw, var(--vh-heading-desktop));
    font-weight: 500;
    line-height: .98;
  }

  .visit-hero h1 span,
  .visit-hero h1 em {
    display: block;
  }

  .visit-hero h1 em {
    color: var(--vh-accent);
    font-style: italic;
  }

  .visit-hero__body {
    max-width: 580px;
    margin-top: 26px;
    font-size: var(--vh-body-size);
    line-height: 1.75;
    opacity: .78;
  }

  .visit-hero__body p {
    margin: 0;
  }

  .visit-hero__actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .visit-hero__button {
    min-height: 48px;
    padding: 0 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid currentColor;
    font-size: 12px;
    font-weight: 850;
    line-height: 1;
    text-decoration: none;
    transition: transform .2s ease, filter .2s ease;
  }

  .visit-hero__button--primary {
    color: var(--vh-primary-text);
    background: var(--vh-primary-bg);
    border-color: var(--vh-primary-bg);
  }

  .visit-hero__button--secondary {
    color: var(--vh-secondary-text);
    background: var(--vh-secondary-bg);
    border-color: var(--vh-secondary-bg);
  }

  .visit-hero__button:hover {
    transform: translateY(-1px);
    filter: brightness(1.04);
  }

  .visit-hero__button:focus-visible {
    outline: 2px solid var(--vh-accent);
    outline-offset: 3px;
  }

  .visit-hero__media {
    position: relative;
    aspect-ratio: 16 / 10;
    min-height: 320px;
    overflow: hidden;
    border-radius: var(--vh-radius);
    background: #eee3d8;
    box-shadow: 0 26px 70px rgba(48, 26, 38, .12);
  }

  .visit-hero__media::before {
    content: "";
    display: block;
    padding-bottom: var(--vh-ratio);
  }

  .visit-hero__media picture,
  .visit-hero__image,
  .visit-hero__empty {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .visit-hero__image {
    object-fit: cover;
    object-position: var(--vh-focal);
  }

  .visit-hero__empty {
    background: linear-gradient(135deg, #efe4d9, #fff9f1);
  }

  .visit-hero__badge {
    position: absolute;
    z-index: 2;
    max-width: min(88%, 420px);
    padding: 14px 18px;
    color: var(--vh-badge-text);
    background: var(--vh-badge-bg);
    font-size: 12px;
    font-weight: 850;
    line-height: 1.25;
  }

  .visit-hero__badge--bottom_right {
    right: 18px;
    bottom: 18px;
  }

  .visit-hero__badge--bottom_left {
    left: 18px;
    bottom: 18px;
  }

  @media (max-width: 900px) {
    .visit-hero__inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .visit-hero--image_first .visit-hero__media {
      order: -1;
    }
  }

  @media (max-width: 767px) {
    .visit-hero__inner--page,
    .visit-hero__inner--wide {
      width: min(100% - 36px, var(--page-width, 1360px));
    }

    .visit-hero__actions {
      display: grid;
    }

    .visit-hero__button {
      width: 100%;
    }

    .visit-hero__media {
      min-height: 260px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .visit-hero__button {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Visit Contact Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Gacha Treasures Las Vegas store interior" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Visit & contact Gacha Treasures" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Find us in Vegas." },
    { "type": "inline_richtext", "id": "accent_heading", "label": "Accent heading", "default": "Or reach us from anywhere." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Visit either Las Vegas location, ask about a specific collectible, or start a conversation about a custom phone case or 3D print. We would love to hear what you are looking for.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "View both locations" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Send us a message" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "checkbox", "id": "show_badge", "label": "Show image badge", "default": true },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "Two Las Vegas locations · online + in person" },
    { "type": "select", "id": "badge_position", "label": "Badge position", "default": "bottom_right", "options": [
      { "value": "bottom_right", "label": "Bottom right" },
      { "value": "bottom_left", "label": "Bottom left" }
    ] },
    { "type": "select", "id": "content_width", "label": "Content width", "default": "page", "options": [
      { "value": "page", "label": "Page width" },
      { "value": "wide", "label": "Wide" }
    ] },
    { "type": "select", "id": "vertical_alignment", "label": "Vertical alignment", "default": "center", "options": [
      { "value": "top", "label": "Top" },
      { "value": "center", "label": "Center" },
      { "value": "bottom", "label": "Bottom" }
    ] },
    { "type": "select", "id": "mobile_order", "label": "Mobile order", "default": "text_first", "options": [
      { "value": "text_first", "label": "Text first" },
      { "value": "image_first", "label": "Image first" }
    ] },
    { "type": "select", "id": "image_position", "label": "Image focal point", "default": "center center", "options": [
      { "value": "center center", "label": "Center" },
      { "value": "center top", "label": "Top" },
      { "value": "center bottom", "label": "Bottom" },
      { "value": "left center", "label": "Left" },
      { "value": "right center", "label": "Right" }
    ] },
    { "type": "range", "id": "left_column", "label": "Left column weight", "min": 8, "max": 14, "step": 1, "default": 10 },
    { "type": "range", "id": "right_column", "label": "Right column weight", "min": 8, "max": 16, "step": 1, "default": 13 },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 32, "max": 120, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "image_ratio", "label": "Image ratio", "min": 48, "max": 80, "step": 4, "unit": "%", "default": 64 },
    { "type": "range", "id": "image_radius", "label": "Image radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size desktop", "min": 60, "max": 112, "step": 2, "unit": "px", "default": 90 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size mobile", "min": 40, "max": 64, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 10, "max": 14, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "body_size", "label": "Body size", "min": 13, "max": 18, "step": 1, "unit": "px", "default": 15 },
    { "type": "color", "id": "background", "label": "Background", "default": "#F8F1E8" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#2D1723" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#C83E76" },
    { "type": "color", "id": "body_color", "label": "Body", "default": "#786A70" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#DDD1C7" },
    { "type": "color", "id": "primary_background", "label": "Primary background", "default": "#C83E76" },
    { "type": "color", "id": "primary_text", "label": "Primary text", "default": "#FFFFFF" },
    { "type": "color", "id": "secondary_background", "label": "Secondary background", "default": "#27091E" },
    { "type": "color", "id": "secondary_text", "label": "Secondary text", "default": "#FFFFFF" },
    { "type": "color", "id": "badge_background", "label": "Badge background", "default": "#27091E" },
    { "type": "color", "id": "badge_text_color", "label": "Badge text", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Desktop padding top", "min": 48, "max": 160, "step": 4, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_bottom", "label": "Desktop padding bottom", "min": 48, "max": 160, "step": 4, "unit": "px", "default": 116 },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile padding top", "min": 36, "max": 100, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile padding bottom", "min": 36, "max": 100, "step": 2, "unit": "px", "default": 68 }
  ],
  "presets": [
    { "name": "Visit Contact Hero" }
  ]
}
{% endschema %}
